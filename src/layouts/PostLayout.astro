---
/* Khung chung cho mọi bài viết (src/content/posts/*.mdx): render thân bài + TOC
   rồi đưa vào InnerPageLayout. */
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import InnerNavigator from "@/components/article/InnerNavigator.astro";
import PostIntro from "@/components/article/PostIntro.astro";
import PostSidebar from "@/components/sidebar/PostSidebar.astro";
import { KNOWLEDGE_INDEX, postUrl } from "@/lib/links";
import { breadcrumbSchema, articleSchema } from "@/lib/schema-org";

interface Props {
  /* Nhận thẳng entry, KHÔNG nhận `slug: string`. Trang đã lấy entry trong
     getStaticPaths rồi; truyền lại tên dưới dạng chuỗi để layout đi tra lần nữa
     là đúng thứ "chuỗi tra bảng" mà reference() sinh ra để diệt — và nó kéo theo
     một lần `throw` runtime cho thứ mà kiểu đã bảo đảm. */
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, date, readTime, heroMobileTitle } = entry.data;

/* Tác giả (tên/vai trò/ảnh) lấy từ collection `authors` qua reference().
   Map AVATARS hardcode trước đây đã bỏ — gõ sai tên tác giả giờ là lỗi build
   chứ không phải avatar `undefined` âm thầm. */
const author = (await getEntry(entry.data.author))!.data;

const crumbs = [{ text: "Home" }, { text: "Knowledge", href: KNOWLEDGE_INDEX }, { text: title }];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({
    title,
    description: entry.data.excerpt,
    url: postUrl(entry.id),
    image: entry.data.images.card.src,
    authorName: author.name,
  }),
];
---

{
  /* Bài viết: banner hiện chính tiêu đề bài (cả desktop lẫn mobile).

    Mốc breadcrumb giữa: bản gốc ghi "-" — chuyên mục RỖNG, di chứng của việc
    bài viết nằm ở gốc site không thuộc đâu cả. Giờ bài nằm dưới /knowledge/ nên
    mốc đó có tên thật. Đây là 1 trong 3 khác biệt được phép (CLAUDE.md §4). */
}
<InnerPageLayout
  title={title}
  description={entry.data.excerpt}
  image={entry.data.images.card.src}
  type="article"
  schema={schema}
  heroTitle={title}
  heroMobileTitle={heroMobileTitle ?? title}
  crumbs={crumbs}
>
  <div class="post-layout">
    {/* TOC "Navigate" lấy từ h3 trong thân bài */}
    <InnerNavigator headings={headings} />
    <main class="post-layout__main">
      <PostIntro
        title={title}
        date={date}
        readTime={readTime}
        author={author}
        avatar={author.avatar}
      />
      <div class="post__body">
        <Content />
      </div>
    </main>
    <PostSidebar postId={entry.id} />
  </div>
</InnerPageLayout>

<style>
  /* Cùng lưới với trang review: <1025px xếp 1 cột (nội dung → sidebar), TOC ẩn */
  .post-layout {
    width: 95%;
    margin: 10px;
    display: grid;
    grid-template-areas:
      "main"
      "sidebar";
    grid-template-columns: 100%;
  }
  .post-layout__main {
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .post-layout {
      max-width: 1060px;
      margin: 25px auto;
      grid-template-areas: "nav main sidebar";
      grid-template-columns: 1fr 2.8fr 1fr;
      gap: 10px;
    }
    .post-layout__main {
      /* Bản gốc KHÔNG chừa margin đáy ở cột nội dung (khoảng cách tới footer chỉ
         do margin 25px của lưới) — bỏ 10px đáy kế thừa từ base */
      margin: 0;
      padding-right: 20px;
      border: none;
    }
  }
</style>
