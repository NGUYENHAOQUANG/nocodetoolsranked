---
/* Khung chung cho mọi bài viết (src/content/posts/*.mdx). Trang chỉ cần truyền
   `slug`; layout tự lấy entry, render thân bài + TOC, và dựng đủ Header/Hero/
   Breadcrumbs/PostIntro/PostSidebar/Footer. */
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import InnerNavigator from "@/components/article/InnerNavigator.astro";
import PostIntro from "@/components/article/PostIntro.astro";
import PostSidebar from "@/components/sidebar/PostSidebar.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import { KNOWLEDGE_INDEX, postUrl } from "@/lib/links";
import { breadcrumbSchema, articleSchema } from "@/lib/schema-org";

interface Props {
  /** id của bài trong collection `posts` (tên file .mdx không đuôi) */
  slug: string;
}

const { slug } = Astro.props;
const entry = await getEntry("posts", slug);
if (!entry) throw new Error(`Không có bài "${slug}" trong collection blog`);
const { Content, headings } = await render(entry);
const { title, date, readTime, heroMobileTitle } = entry.data;

/* Tác giả (tên/vai trò/ảnh) lấy từ collection `authors` qua reference().
   Map AVATARS hardcode trước đây đã bỏ — gõ sai tên tác giả giờ là lỗi build
   chứ không phải avatar `undefined` âm thầm. */
const author = (await getEntry(entry.data.author))!.data;

const crumbs = [
  { text: "Home" },
  { text: "Knowledge", href: KNOWLEDGE_INDEX },
  { text: title },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({
    title,
    description: entry.data.excerpt,
    url: postUrl(entry.id),
    image: entry.data.images.card.src,
    authorName: author.name,
  }),
];
---

<BaseLayout
  title={title}
  description={entry.data.excerpt}
  image={entry.data.images.card.src}
  type="article"
  schema={schema}
>
  <Header />
  {/* Blog: hero hiện chính tiêu đề bài (cả desktop lẫn mobile) */}
  <Hero
    isInner
    title={title}
    alt={`${title} | Fresh Dog Food Delivery`}
    mobileTitle={heroMobileTitle ?? title}
    mobileAlt={`${title} | Fresh Dog Food Delivery`}
  />
  {/* Bản gốc ghi mốc giữa là "-" — chuyên mục RỖNG, di chứng của việc bài viết
      nằm ở gốc site không thuộc đâu cả. Giờ bài nằm dưới /knowledge/ nên mốc đó
      có tên thật. Đây là 1 trong 3 khác biệt được phép (CLAUDE.md §4). */}
  <Breadcrumbs items={crumbs} />

  <div class="post-layout">
    {/* TOC "Navigate" lấy từ h3 trong thân bài */}
    <InnerNavigator headings={headings} />
    <main class="post-layout__main">
      <PostIntro title={title} date={date} readTime={readTime} author={author} avatar={author.avatar} />
      <div class="post__body">
        <Content />
      </div>
    </main>
    <PostSidebar postId={entry.id} />
  </div>

  <Footer />
  <ToTop />
</BaseLayout>

<style>
  /* Cùng lưới với trang review: <1025px xếp 1 cột (nội dung → sidebar), TOC ẩn */
  .post-layout {
    width: 95%;
    margin: 10px;
    display: grid;
    grid-template-areas:
      "main"
      "sidebar";
    grid-template-columns: 100%;
  }
  .post-layout__main {
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .post-layout {
      max-width: 1060px;
      margin: 25px auto;
      grid-template-areas: "nav main sidebar";
      grid-template-columns: 1fr 2.8fr 1fr;
      gap: 10px;
    }
    .post-layout__main {
      /* Bản gốc KHÔNG chừa margin đáy ở cột nội dung (khoảng cách tới footer chỉ
         do margin 25px của lưới) — bỏ 10px đáy kế thừa từ base */
      margin: 0;
      padding-right: 20px;
      border: none;
    }
  }

</style>
