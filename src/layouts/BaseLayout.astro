---
import { getEntry } from "astro:content";
import "@/styles/global.css";
import Seo from "@/components/layout/Seo.astro";
import { Font } from "astro:assets";
import { SITE } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  /** Ảnh chia sẻ mạng xã hội (đường dẫn trong site) */
  image?: string;
  type?: "website" | "article";
  /** Chặn lập chỉ mục — hiện chỉ trang 404 dùng */
  noindex?: boolean;
  /** JSON-LD — xem lib/schema-org.ts */
  schema?: Record<string, unknown>[];
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  image,
  type = "website",
  noindex = false,
  schema = [],
} = Astro.props;

/* Nhãn dùng chung toàn site, không đổi theo trang -> tự lấy thay vì truyền props. */
const labels = (await getEntry("labels", "labels"))!.data;
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="nocodetoolsranked" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      schema={schema}
    />
    {
      /* `astro:fonts` phát @font-face kèm fallback ĐÃ KHỚP METRIC. Fallback đó khử
        SẠCH phần nhảy theo CHIỀU DỌC — đã đo trên 788 phần tử: 0 phần tử đổi vị trí
        dọc, 0 phần tử đổi chiều cao khi font về.

        Nhưng nó KHÔNG khử được lệch NGANG: capsize chỉnh `size-adjust` và
        `ascent/descent-override`, không chỉnh được bề rộng từng chữ cái. "Visit Site"
        rộng 62,69px với Lato so với 59,80px với fallback — lệch 4,6%, nên chữ trong
        nút bề rộng CỐ ĐỊNH căn lại ~1,7px lúc swap. Nhìn thấy được.

        `preload` BẬT để chặn nốt phần đó. Đã đo trước/sau trên mạng 1,6 Mbps để chắc
        nó không cướp băng thông của ảnh LCP — số liệu trong CLAUDE.md.

        Poppins KHÔNG khai ở đây — nó chỉ dùng trong `ExitPopup` (1/21 trang), nên
        `<Font cssVariable="--font-popup" />` đặt trong chính component đó để 20
        trang còn lại không phải mang theo khai báo thừa. */
    }
    <Font cssVariable="--font-brand" preload />
    <!-- Google tag (gtag.js) -->
    {
      GA_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${GA_ID}');
            `}
          />
        </>
      )
    }
  </head>
  <body>
    {
      /* Skip link — WCAG 2.4.1 mức A. Không có nó, người dùng bàn phím phải tab
        qua toàn bộ menu header trên MỌI trang mới tới nội dung.

        Đích là `#main-content`; mỗi page tự đặt id đó lên `<main>` của mình, vì
        `InnerPageLayout` cố ý không phát `<main>` (trang review và bài blog đặt
        `<main>` bên trong lưới ba cột). `check-html.mjs` canh cho khỏi quên. */
    }
    <a class="skip-link" href="#main-content">{labels.skipLink}</a>
    <slot />
  </body>
</html>

<style>
  /* Đẩy ra ngoài màn chứ KHÔNG `display: none`: thẻ ẩn kiểu đó không nhận được
     tiêu điểm, tức là mất đúng công dụng của skip link. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 2147483001;
    padding: 10px 16px;
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
