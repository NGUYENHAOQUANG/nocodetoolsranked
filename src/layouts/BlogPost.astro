---
/* Khung chung cho mọi bài blog (src/content/blog/*.mdx). Trang chỉ cần truyền
   `slug`; layout tự lấy entry, render thân bài + TOC, và dựng đủ Header/Hero/
   Breadcrumbs/BlogIntro/BlogSidebar/Footer. */
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import InnerNavigator from "../components/InnerNavigator.astro";
import BlogIntro from "../components/BlogIntro.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import Footer from "../components/Footer.astro";
import ToTop from "../components/ToTop.astro";
import steveAvatar from "../assets/images/author-steve-diller.png";
import periAvatar from "../assets/images/author-peri-elgrot.png";

/** Ảnh đại diện tác giả theo key `avatar` trong frontmatter */
const AVATARS = {
  "steve-diller": steveAvatar,
  "peri-elgrot": periAvatar,
};

interface Props {
  /** id của bài trong collection `blog` (tên file .mdx không đuôi) */
  slug: string;
}

const { slug } = Astro.props;
const entry = await getEntry("blog", slug);
const { Content, headings } = await render(entry!);
const { title, date, readTime, author, avatar, sidebarArticles, heroMobileTitle } =
  entry!.data;
---

<BaseLayout title={title}>
  <Header />
  {/* Blog: hero hiện chính tiêu đề bài (cả desktop lẫn mobile) */}
  <Hero
    inner
    title={title}
    alt={`${title} | Fresh Dog Food Delivery`}
    mobileTitle={heroMobileTitle ?? title}
    mobileAlt={`${title} | Fresh Dog Food Delivery`}
  />
  {/* Bản gốc có mốc giữa "-" (chuyên mục rỗng): Home > - > tiêu đề */}
  <Breadcrumbs items={[{ text: "Home" }, { text: "-" }, { text: title }]} />

  <div class="post-layout">
    {/* TOC "Navigate" lấy từ h3 trong thân bài */}
    <InnerNavigator headings={headings} />
    <main class="post-layout__main">
      <BlogIntro title={title} date={date} readTime={readTime} author={author} avatar={AVATARS[avatar]} />
      <div class="post__body">
        <Content />
      </div>
    </main>
    <BlogSidebar articleKeys={sidebarArticles} />
  </div>

  <Footer />
  <ToTop />
</BaseLayout>

<style>
  /* Cùng lưới với trang review: <1025px xếp 1 cột (nội dung → sidebar), TOC ẩn */
  .post-layout {
    width: 95%;
    margin: 10px;
    display: grid;
    grid-template-areas:
      "main"
      "sidebar";
    grid-template-columns: 100%;
  }
  .post-layout__main {
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .post-layout {
      max-width: 1060px;
      margin: 25px auto;
      grid-template-areas: "nav main sidebar";
      grid-template-columns: 1fr 2.8fr 1fr;
      gap: 10px;
    }
    .post-layout__main {
      /* Bản gốc KHÔNG chừa margin đáy ở cột nội dung (khoảng cách tới footer chỉ
         do margin 25px của lưới) — bỏ 10px đáy kế thừa từ base */
      margin: 0;
      padding-right: 20px;
      border: none;
    }
  }

  /* ===== Thân bài (do MDX render → :global) ===== */
  .post__body {
    color: #2d2d2d;
    font-size: 1rem;
    line-height: 1.7rem;
  }
  .post__body :global(p) {
    /* 1em (không phải 16px cứng) để co theo root 14px ở mobile như bản gốc */
    margin: 1em 0;
  }
  .post__body :global(h3) {
    /* Bản gốc: h3 margin 1.25rem trên+dưới (co ở mobile); RIÊNG h3 đầu tiên mt 0 */
    margin: 1.25rem 0;
    color: #2d2d2d;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 2.2rem;
  }
  .post__body :global(h3:first-of-type) {
    margin-top: 0;
  }
  /* Một số bài (vd "why-fresh-food") dùng h2 cho mục thay vì h3: 25px, đậm,
     margin 0.83em (mặc định h2); mục h2 ĐẦU TIÊN bỏ margin trên */
  .post__body :global(h2) {
    margin: 0.83em 0;
    color: #2d2d2d;
    font-size: 1.5625rem;
    font-weight: 700;
    line-height: 2.2rem;
  }
  .post__body :global(h2:first-of-type) {
    margin-top: 0;
  }
  /* Ảnh trong bài giữ đúng kích thước gốc (300×300), căn trái */
  .post__body :global(img) {
    max-width: 100%;
    height: auto;
  }
  /* Danh sách gạch đầu dòng (vd bài "gut health"): bản gốc dùng bullet rỗng
     (circle), thụt 40px, ul không margin, mỗi mục cách nhau 15px */
  .post__body :global(ul) {
    margin: 0;
    padding-left: 40px;
    list-style-type: circle;
  }
  .post__body :global(li) {
    margin: 15px 0;
    line-height: 1.5;
  }
</style>
