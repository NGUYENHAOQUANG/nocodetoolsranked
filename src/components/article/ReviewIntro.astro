---
import { AFFILIATE_REL } from "@/lib/links";
import type { ImageMetadata } from "astro";
import likeIcon from "@/assets/icons/like.png";

interface Props {
  /** Logo đối tác ở thanh trên — mỗi trang review truyền logo riêng */
  logo: ImageMetadata;
  logoAlt: string;
  promo: string;
  href: string;
  /** Tác giả lấy từ collection `authors` — gồm cả ảnh đại diện */
  author: { name: string; role: string; avatar: ImageMetadata };
}

const { logo, logoAlt, promo, href, author } = Astro.props;
---

{/* Thanh khuyến mãi + tác giả — phần đầu cột giữa, trên bài viết */}
<section class="review-intro">
  <div class="review-intro__promote">
    <img class="review-intro__logo" src={logo.src} alt={logoAlt} width="215" height="70" />
    <div class="review-intro__promo-text">
      {
        /* Ô bọc BLOCK (bản gốc là div cursor:pointer): nhờ nó là block nên margin
          của like-icon và <p> thu gọn (collapse). Nếu để like-icon + <p> làm con
          trực tiếp của flex thì margin không collapse → promo rỗng dư 16px. */
      }
      <div class="review-intro__promo-inner">
        {
          /* Ô bọc icon: dưới 1240px nó là BLOCK nên <img> nằm INLINE trên baseline →
            cao 44.8px chứ không phải 38px. Từ 1240px mới chuyển sang flex. */
        }
        <div class="review-intro__like-icon">
          {/* Bản gốc dùng ẢNH PNG 44×38 cho icon này, không phải SVG */}
          <img
            class="review-intro__thumb"
            src={likeIcon.src}
            alt="Like icon"
            width="44"
            height="38"
          />
        </div>
        <p>{promo}</p>
      </div>
    </div>
    <div class="review-intro__cta">
      {
        /* Ô trong rộng 157px nằm trong ô ngoài 140px: bản gốc cho nút tràn phải
          bằng margin âm -17px, rồi kéo cả cụm sang trái 10px */
      }
      <div class="review-intro__cta-inner">
        <a
          class="review-intro__button"
          href={href}
          title="View Rates"
          target="_blank"
          rel={AFFILIATE_REL}
          referrerpolicy="strict-origin"
        >
          View Rates
        </a>
      </div>
    </div>
  </div>
</section>

<section class="review-intro__author-section">
  <div class="review-intro__author">
    <img
      class="review-intro__avatar"
      src={author.avatar.src}
      alt="Author image"
      width="45"
      height="45"
    />
    <div class="review-intro__author-text">
      <p class="review-intro__author-name">{author.name}</p>
      <p>{author.role}</p>
    </div>
  </div>
</section>

<style>
  /* Rule chung cho mọi <section> của bản gốc: padding 0 10px, margin 0 (mốc
     1025 mới đổi thành 2px auto 30px — xem cuối file) */
  .review-intro,
  .review-intro__author-section {
    margin: 0;
    padding-inline: 10px;
  }

  .review-intro__promote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 15px 12px;
    border-bottom: 1px solid #ecebeb;
  }
  /* CSS gốc ghi max-width:30% / max-height:120px nhưng style INLINE đè cả hai
     thành 100% → giá trị thật là 100%. Cỡ cuối (126.63×41.22) do flex-shrink
     kéo từ base 30% (=162.8px) xuống. */
  .review-intro__logo {
    width: 30%;
    max-width: 100%;
    min-width: 95px;
    height: max-content;
    max-height: 100%;
    object-fit: contain;
  }
  .review-intro__promo-text {
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  /* Bản gốc gắn class chung `general_xmedium-larger-display` → ẩn hẳn cụm chữ
     khuyến mãi dưới 768px (hoặc màn thấp <420px), chỉ còn logo + nút */
  @media (max-width: 767px), (max-height: 419px) {
    .review-intro__promo-text {
      display: none;
    }
  }
  /* margin 1em là mặc định của <p> → 16px ở desktop, 14px khi root còn 14px.
     KHÔNG hardcode 16px: dưới 1025px sẽ dư 4px. */
  .review-intro__promo-text p {
    margin: 1em 0;
    color: var(--color-text-body);
  }
  .review-intro__cta {
    position: relative;
    /* Lệch trái 10px so với chỗ flex space-between đặt nó */
    right: 10px;
    width: 140px;
    min-width: 140px;
    max-width: 140px;
    font-size: 0.9375rem;
    font-weight: 100;
  }
  /* Ô trong: DƯỚI 768px bản gốc để width:100% + min-width:50% (không phải 157px),
     nút tự phình tới min-content (~147px) và tràn phải khỏi ô ngoài 140px. Chỉ từ
     768px mới ép 157px + margin âm để tràn 17px. */
  /* Bản gốc hardcode ô trong = 147px (rule `.partner-button-container div{width:147px}`),
     tràn phải khỏi ô ngoài 140px đúng 7px. Từ 768px min-width:157px nâng lên 157. */
  .review-intro__cta-inner {
    position: relative;
    width: 147px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .review-intro__button {
    --hover-bg-color: var(--color-secondary);

    width: 100%;
    max-width: 100%;
    min-height: 47px;
    height: 48px;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    /* 1.3em của cha (13.125px @mobile / 15px @desktop) — KHÔNG phải 1.2rem như CTA khác */
    font-size: 1.3em;
    font-weight: 700;
    line-height: 1rem;
    letter-spacing: 0.02em;
    transition: all 0.2s linear;
  }
  @media (min-width: 768px) and (min-height: 420px) {
    .review-intro__cta-inner {
      min-width: 157px;
      margin-right: -17px;
    }
    .review-intro__button {
      font-weight: 600;
    }
  }
  /* Bản gốc hạ độ đậm về 400 từ mốc 1240 (rule .partner-button-container a) */
  @media (min-width: 1240px) and (min-height: 420px) {
    .review-intro__button {
      font-weight: 400;
    }
  }

  .review-intro__author-section {
    /* Bản gốc khai `padding-left: 0` cho section này nhưng rule chung
       `.page_page section:not(...)` (0,2,1) THẮNG → padding thật vẫn là 0 10px */
    margin: 0;
  }
  .review-intro__author {
    display: flex;
    flex-wrap: wrap;
    padding: 15px 0 0;
  }
  .review-intro__avatar {
    width: 25%;
    min-width: 45px;
    max-width: 45px;
    min-height: 45px;
    max-height: 65px;
    flex-shrink: 0;
    border-radius: 110%;
    object-fit: contain;
  }
  .review-intro__author-text {
    display: flex;
    flex-flow: column;
    justify-content: center;
    font-size: 0.85rem;
    line-height: 1.2rem;
  }
  .review-intro__author-text p {
    margin: 0 10px;
    white-space: nowrap;
    color: var(--color-text-intro);
  }
  .review-intro__author-name {
    font-weight: 600;
  }

  @media (min-width: 615px) {
    .review-intro__button:hover {
      background-color: var(--hover-bg-color);
    }
  }

  /* Từ 1025px bản gốc mới cho <section> margin 2px auto 30px (dưới mốc này là 0).
     Section tác giả vẫn giữ margin 0 nhờ rule riêng ở trên. */
  @media (min-width: 1025px) and (min-height: 420px) {
    .review-intro {
      margin: 2px auto 30px;
    }
  }

  /* Từ 1240px icon mới thành flex → <img> bị blockify, mất phần lồi dưới baseline
     và ăn `width:auto` (38px thay vì 44px của thuộc tính) */
  @media (min-width: 1240px) and (min-height: 420px) {
    .review-intro__like-icon {
      width: auto;
      display: flex;
      justify-content: center;
    }
    .review-intro__thumb {
      width: auto;
      margin: 0 auto;
      object-fit: contain;
    }
  }
</style>
