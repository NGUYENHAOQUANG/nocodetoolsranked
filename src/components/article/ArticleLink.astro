---
/* Link tên đối tác ở cuối bài. Bản gốc là <div> + onClick (không phải <a>) nên
   tái hiện bằng script nhỏ. */
interface Props {
  name: string;
  href: string;
}

const { name, href } = Astro.props;
---

<div class="text-link" data-href={href}>
  <div class="text-link__inner">
    <div class="text-link__content">{name}</div>
  </div>
</div>

<style>
  .text-link {
    width: max-content;
    /* Margin do bản gốc đặt ở cha (.review > div > div) */
    margin: 10px 0 30px;
    /* Màu chữ mặc định của trang gốc là #2d2d2d, không phải #000 kế thừa từ body */
    color: var(--color-text-body);
    cursor: pointer;
  }
  .text-link__inner {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .text-link__content {
    --hover-color: var(--color-primary);

    width: max-content;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3em;
    text-decoration: underline;
  }

  @media (min-width: 615px) {
    .text-link__content:hover {
      color: var(--hover-color);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".text-link").forEach((el) => {
    el.addEventListener("click", () => {
      const href = el.dataset.href;
      if (href) window.open(href, "_blank", "noopener");
    });
  });
</script>
