---
/* Bài viết nay là MDX trong content collection (src/content/articles) cho dễ
   soạn: prose viết markdown thường, chèn CTA bằng <InlineCta/>. Component này
   chỉ bọc + style. */
import { getEntry, render } from "astro:content";

const entry = await getEntry("articles", "why-fresh-dog-food");
const { Content } = await render(entry!);
---

<div class="article">
  <Content />
</div>

<style>
  .article {
    width: 100%;
    /* Dưới 1025px khối này nằm thẳng trong section (không còn lưới) nên mới lộ
       giới hạn 95dvw của bản gốc — ở desktop nó bị cột lưới 680px che mất */
    max-width: min(95dvw, 1060px);
    margin-inline: auto;
    /* Bản gốc tạo BFC bằng `overflow-x: scroll` (để bảng rộng cuộn ngang được).
       Tác dụng phụ mới là thứ quyết định layout: nó giữ margin 16px của đoạn
       cuối nằm TRONG khối — bỏ đi thì khối hụt 16px. Trang này không có bảng
       nên dùng flow-root cho đúng ý đồ. */
    display: flow-root;
    line-height: 1.7rem;
    font-weight: 400;
    color: var(--color-text-body);
  }

  /* Nội dung do MDX render (không mang scope của component) → phải :global.
     Bản gốc dựa vào margin mặc định của trình duyệt, nhưng global.css đã reset
     margin của h2/p về 0 nên phải khai lại: h2 = .83em, p = 1em */
  .article :global(h2) {
    margin: 0.83em 0;
    font-size: 1.5625rem;
    line-height: 2.2rem;
    color: var(--color-text-body);
  }
  .article :global(h2:first-of-type) {
    margin-top: 0;
  }

  .article :global(p) {
    margin: 1em 0;
  }
  /* (MDX render p/h2 nên dùng :global; xem ghi chú trên) */

  /* Tiểu mục = `**text**` trong MDX → <p><strong>. Giữ <p> ở weight 400 (kế thừa
     từ .article) để UA cho <strong> `bolder` ra đúng 700 (cha 700 sẽ thành 900). */
</style>
