---
/**
 * Khối bài viết dài ở trang chủ. Nội dung nằm ở
 * `content/featured-articles/homepage.mdx` — prose viết Markdown thường, CTA
 * chèn bằng `<InlineCta brand="..." />`.
 *
 * Component chỉ bọc và render. Style thân bài nằm ở `styles/prose.css` cùng ba
 * khối prose kia: nội dung do MDX sinh nằm NGOÀI phạm vi scoped, nên để trong
 * `<style>` của file này thì phải bọc `:global()` từng rule — mà như vậy thì
 * chúng đã là global rồi, chỉ khác là nằm lạc chỗ.
 */
import { getEntry, render } from "astro:content";

const entry = await getEntry("featuredArticles", "homepage");
if (!entry) throw new Error("Thieu src/content/featured-articles/homepage.mdx");
const { Content } = await render(entry);
---

<div class="article">
  {
    /* Tiêu đề lấy từ frontmatter, thân bài KHÔNG lặp lại — trước đây cùng một
      chuỗi nằm ở cả hai chỗ và trường `title` thì không nơi nào dùng tới. */
  }
  <h2 class="article__title">{entry.data.title}</h2>
  <Content />
</div>
