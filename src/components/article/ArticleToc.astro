---
import type { MarkdownHeading } from "astro";

interface Props {
  /** Lấy từ render(entry) của MDX — mọi heading trong bài đều lên TOC */
  headings: MarkdownHeading[];
}

/** Bỏ heading rỗng: vài bài dùng <h2></h2>/<h3></h3> rỗng làm spacer sau ảnh —
    chúng KHÔNG được lên TOC (bản gốc cũng vậy). */
const { headings: allHeadings } = Astro.props;
const headings = allHeadings.filter((h) => h.text.trim());
---

{
  /* Bản gốc đánh dấu mục đang xem bằng text-shadow (scroll-spy). Ở ĐẦU trang
    (chưa cuộn) KHÔNG mục nào được tô — chỉ tô khi cuộn qua heading tương ứng. */
}
<nav class="article-toc" aria-label="Article contents">
  <div class="article-toc__content">
    <h2 class="article-toc__title">Navigate</h2>
    {
      headings.map((h) => (
        <a class="article-toc__link" href={`#${h.slug}`} data-target={h.slug}>
          <div class="article-toc__item">{h.text}</div>
        </a>
      ))
    }
  </div>
  {/* Dải mờ dần ở đáy, báo hiệu còn cuộn được */}
  <div class="article-toc__fade" aria-hidden="true"></div>
</nav>

<style>
  .article-toc {
    --article-toc-bg: var(--color-surface-muted);

    /* Bản gốc ẩn hẳn TOC dưới 1025px */
    display: none;
    position: sticky;
    top: 10px;
    width: 180px;
    max-height: 500px;
    height: max-content;
    overflow-y: auto;
    scroll-behavior: smooth;
    /* CSS bản gốc ghi #e8e8e8 nhưng inline style đặt #f5f5f5 → màu thật là #f5f5f5 */
    background-color: var(--article-toc-bg);
    border-radius: 5px;
    box-shadow: 0 0 3px var(--color-shadow);
  }

  .article-toc__content {
    padding: 0 10px 10px;
  }

  .article-toc__title {
    position: sticky;
    top: 0;
    width: 100%;
    /* global.css reset margin h1-h6 về 0; bản gốc cũng ép margin-top 0 nên chỉ còn đáy 5px */
    margin: 0 0 5px;
    /* Khai tường minh vì thẻ đã đổi h4 -> h2 (h4 đứng ngay dưới h1 là nhảy cấp).
       Hai giá trị này ĐÚNG BẰNG mặc định UA của h4, nên đổi thẻ là 0 pixel. */
    font-size: 1em;
    font-weight: 700;
    padding: 5px 0;
    background-color: var(--article-toc-bg);
    border-bottom: 2px solid #d2d2d2;
  }

  .article-toc__item {
    padding: 10px 3px;
    line-height: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }

  /* Mục đang xem: bản gốc làm đậm bằng text-shadow chứ không đổi font-weight
     (đổi weight sẽ làm chữ giãn ra và đẩy layout) */
  .article-toc__link.is-active {
    text-shadow: 0.5px 0 0 #000;
  }

  .article-toc__fade {
    position: sticky;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 16px;
    background: linear-gradient(180deg, transparent 0, var(--article-toc-bg) 100%);
    pointer-events: none;
  }

  /* Thanh cuộn mảnh, chỉ hiện khi rê chuột vào khung */
  .article-toc::-webkit-scrollbar {
    width: 5px;
    height: 5px;
    background-color: transparent;
  }
  .article-toc::-webkit-scrollbar-track {
    background-color: transparent;
  }
  .article-toc::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 16px;
  }
  .article-toc:hover::-webkit-scrollbar-thumb {
    background-color: #a0a0a5;
  }
  .article-toc::-webkit-scrollbar-button {
    display: none;
  }

  @media (min-width: 615px) {
    /* TEAL: mục lục là điều hướng TRONG trang, cùng vai trò với link nav — không
       phải hành động đi ra đối tác. Trước là `--color-secondary` (hover của nút
       CTA), tức mượn màu của một vai trò khác. */
    .article-toc__item:hover {
      color: var(--color-accent-text);
    }
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .article-toc {
      display: block;
    }
  }
</style>

<script>
  // Scroll-spy: đánh dấu mục ứng với heading đang ở gần đầu màn hình
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".article-toc__link")];
  const targets = links
    .map((l) => document.getElementById(l.dataset.target ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  if (links.length && targets.length) {
    const passed = new Set();
    const sync = () => {
      let currentId: string | null = null;
      targets.forEach((el) => {
        if (passed.has(el.id)) currentId = el.id;
      });
      links.forEach((l) => l.classList.toggle("is-active", l.dataset.target === currentId));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // rootMargin: "-120px..." tạo ranh giới ảo cách top 120px.
          // Khi heading trượt lên trên ranh giới này, nó rời khỏi vùng quan sát (isIntersecting = false).
          if (!entry.isIntersecting && entry.boundingClientRect.top <= 120) {
            passed.add(entry.target.id);
          } else {
            passed.delete(entry.target.id);
          }
        });
        sync();
      },
      { rootMargin: "-120px 0px 0px 0px" }
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
