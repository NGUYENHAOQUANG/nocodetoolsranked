---
import { Image } from "astro:assets";
import { mustReads } from "../data/mustReads";
---

<aside class="must-reads">
  <h3 class="must-reads__title">Must Reads</h3>
  {
    mustReads.map((item) => (
      <a class="must-reads__item" href={item.href}>
        <h4 class="must-reads__item-title">{item.title}</h4>
        <div class="must-reads__excerpt">
          <p>{item.excerpt}</p>
          {/* Đoạn rỗng có sẵn trong nội dung CMS của bản gốc — trông thừa nhưng
              chiếm 24px + margin, bỏ đi là ảnh bị kéo lên 37px */}
          <p>&nbsp;</p>
        </div>
        <div class="must-reads__image">
          <Image src={item.image} alt={item.imageAlt} width={320} height={219} />
        </div>
        <div class="must-reads__link">
          <span>Read More</span>
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"
            />
          </svg>
        </div>
      </a>
    ))
  }
</aside>

<style>
  .must-reads {
    width: 100%;
    height: max-content;
    padding: 10px 40px;
    background-color: #f5f5f5;
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.1);
  }

  .must-reads__title {
    /* global.css reset margin h3 về 0, bản gốc dùng margin mặc định của trình
       duyệt cho h3 = 1em (25.6px) — không phải 0.83em như h2 */
    margin: 1em 0;
    padding-bottom: 10px;
    font-size: 1.6rem;
    font-weight: 400;
    color: #2d2d2d;
  }

  .must-reads__item {
    display: block;
    height: max-content;
    position: relative;
    color: #000;
    font-weight: 100;
    cursor: pointer;
    --hover-color: var(--color-primary);
  }

  .must-reads__item-title {
    /* Khoảng cách giữa các bài chính là margin trên của tiêu đề (1.33em) */
    margin: 1.33em 0 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .must-reads__excerpt > * {
    color: inherit;
  }
  .must-reads__excerpt p {
    margin: 13px 0;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.5rem;
    opacity: 0.7;
  }

  .must-reads__image {
    height: 180px;
    position: relative;
  }
  .must-reads__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Lớp phủ mờ dần khi rê chuột lên ảnh */
  .must-reads__image::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: inherit;
    opacity: 0;
    cursor: pointer;
    transition: all 0.3s linear;
  }
  .must-reads__image:hover::before {
    opacity: 0.1;
    z-index: 1;
  }

  .must-reads__link {
    max-width: 100%;
    width: max-content;
    margin-top: 5px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 0.9375rem;
    font-weight: 400;
  }
  .must-reads__link:hover {
    text-decoration: underline;
  }
  .must-reads__link svg {
    position: relative;
    top: 1px;
  }

  /* Bản gốc đổi màu từng phần riêng lẻ khi rê chuột (chỉ bật từ 615px) */
  @media (min-width: 615px) {
    .must-reads__item-title:hover,
    .must-reads__excerpt:hover,
    .must-reads__link:hover {
      color: var(--hover-color);
    }
  }
</style>
