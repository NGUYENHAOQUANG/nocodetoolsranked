---
import type { ReviewEntry } from "../data/reviews";
import { starList } from "../lib/stars";

interface Props {
  review: ReviewEntry;
}

const { review } = Astro.props;
const {
  logo,
  logoAlt,
  text,
  readMoreHref,
  rating,
  ratingLabel,
  stars,
  href,
  trailingBlank = false,
} = Astro.props.review;

// Cung tròn r=47.5 trong viewBox 100×100 — cùng cách dựng với vòng điểm trang chủ
const RADIUS = 47.5;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const ARC = `M 50,50 m 0,-${RADIUS} a ${RADIUS},${RADIUS} 0 1 1 0,${RADIUS * 2} a ${RADIUS},${RADIUS} 0 1 1 0,-${RADIUS * 2}`;
const dashOffset = CIRCUMFERENCE * (1 - Number(rating) / 10);

const starPaths = starList(stars);
---

<div class="review">
  <div class="review__logo">
    <img class="review__logo-img" src={logo.src} alt={logoAlt} width="215" height="115" />
  </div>

  <div class="review__body">
    <div class="review__text">
      {/* Bản gốc bọc nội dung trong <p> (margin mặc định 1em) rồi để "Read More"
          là link INLINE ngay sau — nhờ vậy khối cao 249.63 chứ không phải 217.63 */}
      <p>{text}</p>
      {trailingBlank && <p>&nbsp;</p>}
      <a class="review__more" href={readMoreHref}>Read More</a>
    </div>
  </div>

  <div class="review__grade">
    {/* Vòng điểm và sao nằm CHUNG một ô: 130 (vòng) + 10 (margin) + 16 (sao) = 156 */}
    <div class="review__ring">
      <div class="review__ring-inner">
        <svg class="review__ring-svg" viewBox="0 0 100 100" aria-hidden="true">
          <path
            class="review__ring-trail"
            d={ARC}
            stroke-width="5"
            fill-opacity="0"
            style={`stroke-dasharray: ${CIRCUMFERENCE}px, ${CIRCUMFERENCE}px;`}></path>
          <path
            class="review__ring-arc"
            d={ARC}
            stroke-width="5"
            fill-opacity="0"
            style={`stroke-dasharray: ${CIRCUMFERENCE}px, ${CIRCUMFERENCE}px; stroke-dashoffset: ${dashOffset}px;`}></path>
        </svg>

        {/* Lớp phủ PHẢI absolute — để relative nó ăn vào chiều cao ô và vòng hụt mất */}
        <div class="review__ring-overlay">
          <div class="review__grade-content">
            <label>{ratingLabel}</label>{rating}
          </div>
        </div>
      </div>

      <div class="review__stars" aria-hidden="true">
        <div class="review__stars-row">
          {
            starPaths.map((star) => (
              <svg
                class:list={["review__star", `review__star--${star.kind}`]}
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path d={star.d} />
              </svg>
            ))
          }
        </div>
      </div>
    </div>

    <div class="review__cta">
      {/* Cần lớp trong này: nút dùng height:100% nên phải quy chiếu vào một ô cao
          `auto` (min-height 45) — nếu bám thẳng ô ngoài cao 45px thì ở mobile nút
          cao 45 thay vì 40 và không được căn giữa. */}
      <div class="review__cta-inner">
        <a
          class="review__button"
          href={href}
          title="Visit Site"
          target="_blank"
          rel="noopener nofollow"
          referrerpolicy="strict-origin"
        >
          <span>Visit Site</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     Base = dưới 1025px: xếp dọc — logo / nội dung / điểm
     ========================================================================== */
  .review {
    width: 95%;
    max-width: 1163px;
    margin: 10px 0;
    padding: 10px 20px;
    display: grid;
    grid-template-areas:
      "icon"
      "content"
      "grade";
    grid-template-rows: auto 0.7fr 1fr;
    border: 1px solid #ddd;
    /* Bản gốc đặt màu chữ này ở wrapper trang rồi cho kế thừa xuống */
    color: #2d2d2d;
  }

  /* Ô logo để trống hoàn toàn: bản gốc có sẵn CSS cho nó (rộng 90%, viền phải)
     nhưng thẻ div lại KHÔNG mang class đó → rule chết, div là block thường. */
  .review__logo {
    grid-area: icon;
  }
  .review__logo-img {
    position: relative;
    width: 85%;
    min-width: 150px;
    /* `height: auto` bắt buộc: thiếu nó ảnh ăn đúng 115px của thuộc tính height
       thay vì cao theo tỉ lệ thật của SVG (→ 77.55px) */
    height: auto;
    max-height: 270px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    object-fit: contain;
  }

  .review__body {
    grid-area: content;
    height: fit-content;
    display: flex;
    flex-flow: column;
    align-items: center;
  }
  .review__text {
    height: fit-content;
  }
  /* global.css reset margin <p> về 0, bản gốc dùng margin mặc định 1em */
  .review__text p {
    margin: 1em 0;
  }

  /* Link inline (không phải block) — nằm ngay sau đoạn văn trên dòng riêng */
  .review__more {
    text-decoration: underline;
    font-weight: 500;
    color: inherit;
  }

  .review__grade {
    grid-area: grade;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
  }

  .review__ring {
    display: block;
    margin-right: 5px;
  }
  /* Cao đúng bằng vòng tròn (130px) — làm mốc cho lớp phủ absolute */
  .review__ring-inner {
    position: relative;
  }
  .review__ring-svg {
    width: 100%;
    max-width: 130px;
    display: flex;
    flex-flow: column;
  }
  /* `round` bắt buộc: hai đầu cung bo tròn phình thêm 2.5px mỗi bên, che kín khe
     hở 2.98px của điểm 9.9 — thiếu nó vòng bị hở một khấc ở đỉnh */
  .review__ring-trail,
  .review__ring-arc {
    stroke-linecap: round;
  }
  .review__ring-trail {
    stroke: #ededed;
  }
  .review__ring-arc {
    stroke: #c5e5f7;
  }
  .review__ring-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .review__grade-content {
    display: flex;
    flex-flow: column;
    align-items: center;
    font-size: 1.4rem;
    font-weight: 400;
  }
  .review__grade-content label {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .review__stars {
    width: fit-content;
    height: auto;
    margin: 10px auto 0;
  }
  .review__stars-row {
    position: relative;
    inset: 0;
    margin: 0 auto;
    display: flex;
    justify-content: space-evenly;
  }
  .review__star {
    width: 1rem;
    height: 1rem;
  }
  .review__star--full,
  .review__star--half {
    color: #ffcd42;
  }
  .review__star--empty {
    color: #e0e0e0;
  }

  /* KHÔNG dùng flex ở đây: bản gốc để ô này là block cao 45px, nút con cao 47px
     bám mép trên và tràn 2px xuống. Căn giữa bằng flex sẽ đẩy nút lên 1px. */
  .review__cta {
    position: relative;
    min-width: min(180px, 100%);
    width: fit-content;
    height: 45px;
    margin-top: 20px;
  }
  .review__cta-inner {
    position: relative;
    width: 100%;
    min-height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .review__button {
    --hover-bg-color: var(--color-secondary);

    width: 100%;
    /* min-height 47px chỉ có từ 768px (xem media query bên dưới) — dưới mốc đó
       nút cao đúng 45px theo ô chứa */
    height: 100%;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: #fff;
    /* Mobile đậm hơn desktop: 1.4rem/700 → 1.2rem/600 từ 768px. Chữ hiển thị lấy
       cỡ từ <span> (1.12rem) nhưng ĐỘ ĐẬM thì kế thừa từ thẻ này. */
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1rem;
    letter-spacing: 0.02em;
    transition: all 0.2s linear;
  }
  .review__button span {
    margin: 5px;
    /* 1.12rem chứ không phải 1.2rem: bản gốc có rule CSS 1.2rem nhưng lại đặt
       inline style 1.12rem ngay trên thẻ span → inline thắng */
    font-size: 1.12rem;
  }

  /* ==========================================================================
     ≥615px — hover (bản gốc chỉ bật từ mốc này)
     ========================================================================== */
  @media (min-width: 615px) {
    .review__button:hover {
      background-color: var(--hover-bg-color);
    }
  }

  /* ==========================================================================
     ≥768px (và cao ≥420px) — hover cho link "Read More"
     ========================================================================== */
  @media (min-width: 768px) and (min-height: 420px) {
    .review__more {
      transition: opacity 0.2s ease-in-out;
    }
    .review__more:hover {
      color: var(--color-primary);
    }
    .review__button {
      min-height: 47px;
      font-size: 1.2rem;
      font-weight: 600;
    }
  }

  /* ==========================================================================
     ≥1025px (và cao ≥420px) — 3 cột: logo | nội dung | điểm
     ========================================================================== */
  @media (min-width: 1025px) and (min-height: 420px) {
    .review {
      grid-template: "icon content grade" 100% / 1fr 2fr 1fr;
      align-items: center;
      min-height: 310px;
      width: 100%;
      margin: 10px auto;
    }
    .review__grade {
      justify-content: flex-start;
    }
  }
</style>
