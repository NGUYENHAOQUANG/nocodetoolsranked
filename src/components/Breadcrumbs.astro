---
interface Props {
  items: string[];
}

const { items } = Astro.props;

const CHEVRON =
  "M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z";
---

{/* Bản gốc để MỌI mốc ở trạng thái `active` (kể cả "Home") — không mốc nào là link */}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {
    items.map((item, i) => (
      <>
        {i > 0 && (
          <svg viewBox="0 0 320 512" width="12" height="12" fill="currentColor" aria-hidden="true">
            <path d={CHEVRON} />
          </svg>
        )}
        <div class="breadcrumbs__crumb breadcrumbs__crumb--active">{item}</div>
      </>
    ))
  }
</nav>

<style>
  /* Bản gốc ẩn hẳn breadcrumbs dưới 1025px (hoặc màn hình cao <420px) */
  .breadcrumbs {
    display: none;
    align-items: center;
    gap: 6px;
    width: 100%;
    max-width: 1060px;
    margin: 15px auto auto;
  }

  .breadcrumbs__crumb--active {
    font-weight: 600;
    cursor: default;
  }
  .breadcrumbs__crumb:not(.breadcrumbs__crumb--active):hover {
    text-decoration: underline;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .breadcrumbs {
      display: flex;
    }
  }
</style>
