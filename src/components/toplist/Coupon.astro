---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="coupon">
  <div class="coupon__bg"></div>
  <div class="coupon__ticket">
    <span class="coupon__scissors">
      <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true">
        <path
          d="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3z"
        ></path>
      </svg>
    </span>
    <span class="coupon__text">{text}</span>
  </div>
</div>

<style>
  /* Màu "mặt sau" của góc gấp khi hover */
  .coupon {
    --back-of-coupon-color: var(--color-secondary);

    position: relative;
    width: 100%;
    margin-top: 5px;
  }

  /* KHÔNG khai `perspective` ở đây. Bản trước có `perspective: 1000px`, nhưng cả TÁM
     `transform` trong file này đều là 2D (`translateY`, `rotate`, `scale`) — mà
     `perspective` chỉ tác động lên transform 3D. Nó không đổi một pixel nào, đổi lại
     tạo ngữ cảnh 3D khiến trình duyệt đẩy khối này lên LỚP COMPOSITE RIÊNG. Trên màn
     DPR cao, lớp đó bị raster rồi ghép ở toạ độ lẻ (đo được x = 30,078px × 3 = 90,234
     pixel thiết bị) nên chữ MỜ. */

  /* Lớp nền cam thò ra sau tấm coupon */
  .coupon__bg {
    position: absolute;
    inset: 1px;
    border-radius: 5px;
    background-color: var(--color-primary);
    z-index: 0;
    transition: transform 0.3s ease;
  }

  .coupon__ticket {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 0;
    border: 2px dashed var(--color-coupon-border);
    border-radius: 8px;
    background-color: var(--color-coupon-bg);
    color: #333;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
    cursor: pointer;
    overflow: visible;
    transition: all 0.3s ease;
  }
  /* `will-change` CHỈ ở thiết bị có hover thật. Nó tồn tại để chuẩn bị cho hiệu ứng
     `:hover` bên dưới, mà điện thoại không hover bao giờ — ở đó nó chỉ còn tác dụng
     phụ: ép lên lớp composite vĩnh viễn, làm chữ mờ trên màn DPR cao. Khác
     `will-change` ở `Header.astro`: cái kia CÓ lý do riêng (ép khử răng cưa grayscale
     cho khớp bản gốc), nên giữ. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .coupon__ticket {
      will-change: transform;
    }
  }

  /* Góc gấp: bung ra khi hover */
  .coupon__ticket::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0;
    border-color: transparent var(--back-of-coupon-color) transparent var(--back-of-coupon-color);
    border-radius: 0 3px 0 8px;
    box-shadow: 1px 1px 5px rgba(0, 0, 0, 0.4);
    transition: border-width 0.2s ease-out;
    z-index: 2;
  }

  .coupon__scissors {
    position: absolute;
    top: -16px;
    right: -5px;
    z-index: 3;
    font-size: 20px;
    color: var(--color-coupon-border);
    transform: rotate(160deg);
    transform-origin: center;
    transition: all 0.3s ease;
  }

  .coupon__text {
    display: block;
    position: relative;
    z-index: 1;
    line-height: 1.5;
    transition: transform 0.3s ease;
  }

  .coupon__ticket:hover {
    transform: translateY(-1px);
    box-shadow:
      0 6px 15px rgba(0, 0, 0, 0.15),
      0 4px 5px var(--color-shadow);
  }
  .coupon__ticket:hover::before {
    border-width: 0 15px 15px 0;
  }
  .coupon__ticket:hover .coupon__scissors {
    transform: rotate(180deg) translateX(25px) scale(1.1);
  }
  .coupon__ticket:hover .coupon__text {
    transform: translateY(-1px);
  }
  .coupon:hover .coupon__bg {
    transform: translateY(-1px);
  }
  .coupon__ticket:active {
    transform: translateY(0);
    transition: all 0.1s ease;
  }

  /* ===== ≥615px ===== */
  @media (min-width: 615px) {
    .coupon {
      display: inline-block;
    }
    .coupon__ticket {
      padding: 12px 16px;
    }
  }

  /* ===== ≥768px ===== */
  @media (min-width: 768px) {
    .coupon__bg {
      inset: 2px;
      border-radius: 6px;
    }
    .coupon__ticket {
      padding: 6px 20px;
      font-size: 0.8rem;
    }
    .coupon__ticket:hover {
      transform: translateY(-2px);
    }
    .coupon__ticket:hover::before {
      border-width: 0 20px 20px 0;
    }
    .coupon:hover .coupon__bg {
      transform: translateY(-2px);
    }
    .coupon__scissors {
      top: -17px;
      font-size: 1.1rem;
    }
  }
</style>
