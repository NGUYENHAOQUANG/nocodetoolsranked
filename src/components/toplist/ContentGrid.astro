---
import type { CollectionEntry } from "astro:content";
import FeaturedArticle from "@/components/toplist/FeaturedArticle.astro";
import MustReads from "@/components/toplist/MustReads.astro";

interface Props {
  toplist: CollectionEntry<"toplists">;
}

const { toplist } = Astro.props;
---

{
  /* Từng có `FaqAccordion` giữa bài viết và sidebar. Trang chủ không còn khối FAQ
    nên nó đã bỏ khỏi đây; `FaqAccordion.astro` vẫn còn trong repo. */
}
<section class="content-grid">
  <FeaturedArticle entry={toplist} />
  <MustReads />
</section>

<style>
  .content-grid {
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 0 10px;
    /* Bên gốc section này là flex item của wrapper trang nên tự là BFC, giữ
       margin đáy của con nằm trong. Ở đây nó là block thường nên phải tạo BFC,
       không thì margin cuối cùng rò ra ngoài và section hụt chiều cao. */
    display: flow-root;
  }

  /* Dưới 1025px bản gốc KHÔNG bật grid: bài viết xếp như block, còn sidebar bị
     ẩn hẳn (class dùng chung `large-larger-display`). */
  .content-grid > :global(.must-reads) {
    display: none;
  }

  /* ===== Desktop ≥1025px (và cao ≥420px) — 2 cột: nội dung | sidebar ===== */
  @media (min-width: 1025px) and (min-height: 420px) {
    .content-grid {
      display: grid;
      grid-template-areas:
        "main sidebar"
        "main sidebar";
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 1fr auto;
      gap: 10px 20px;
      /* Rule chung cho mọi section của trang là `2px auto 30px`, nhưng bên gốc
         section này là flex item nên 2px KHÔNG gộp với margin đáy 20px của section
         trên → cách nhau 22px. Ở đây hai section là block cạnh nhau nên margin gộp,
         phải khai thẳng 22px mới ra đúng khoảng cách. */
      margin: 22px auto 30px;
    }
    .content-grid > :global(.featured-article) {
      grid-column: 1;
    }
    .content-grid > :global(.must-reads) {
      display: block;
      grid-area: sidebar;
    }
  }
</style>
