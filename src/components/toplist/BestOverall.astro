---
import type { ToplistRow } from "@/lib/rankings";
import PartnerCard from "@/components/toplist/PartnerCard.astro";

interface Props {
  /** Tiêu đề mục — RIÊNG từng ngách nên phải truyền vào, không tự lấy. */
  title: string;
  /** Card hạng 1 của trang, lặp lại ở cuối trang đúng như bản gốc */
  brand: ToplistRow;
}

const { title, brand } = Astro.props;
---

<section class="best-overall">
  <div class="best-overall__inner">
    <h2 class="best-overall__title">{title}</h2>
    <PartnerCard brand={brand} shouldShowRank={false} isBestOverall />
  </div>
</section>

<style>
  .best-overall {
    width: 100%;
    margin: 0 auto 30px;
    padding-bottom: 17px;
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }

  .best-overall__inner {
    width: 100%;
    max-width: min(var(--width-content), 95dvw);
    margin-inline: auto;
  }

  .best-overall__title {
    width: 100%;
    margin: 20px 0 0;
    padding: 5px;
    font-size: 1.4rem;
    font-weight: 700;
    text-align: start;
    /* Màu chữ thường như mọi tiêu đề mục khác của site (xem ghi chú ở
       `.post__body h2` trong prose.css) — teal nay chỉ còn ở logo và thanh nav. */
    color: var(--color-text-body);
  }
</style>
