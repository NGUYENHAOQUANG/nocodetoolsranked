---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import promoPopup from "@/assets/promos/promo-popup.webp";
import { CLOSE_X } from "@/lib/icon-paths";
import { AFFILIATE_REL } from "@/lib/links";

/* Brand của creative này. Khai cứng "wix" NGAY CẠNH ảnh cũng khai cứng ở trên —
   hai thứ phải đi cùng nhau: ảnh `promo-popup.webp` vẽ sẵn logo và nút của Wix,
   nên đổi ảnh mà quên đổi id là popup quảng cáo một brand nhưng dẫn sang brand
   khác. Link vẫn đọc từ `content/brands/wix.yaml` để không có bản sao URL thứ hai. */
const promoBrand = (await getEntry("brands", "wix"))!.data;
---

{
  /* Popup exit-intent — hiện khi chuột rời mép trên cửa sổ
    (exit-intent). Xem/đóng rồi thì thôi tới hết PHIÊN. */
}
<div class="exit-popup" hidden>
  <div class="exit-popup__backdrop" data-close></div>
  <div class="exit-popup__box" role="dialog" aria-modal="true" aria-label="Promo offer">
    {
      /* Đứng TRƯỚC ảnh trong DOM để nó là thứ đầu tiên nhận tiêu điểm khi mở —
        người dùng bàn phím thoát được ngay, không phải tab qua khối quảng cáo.
        `data-close` là đủ để nối vào handler, <script> không cần sửa gì. */
    }
    <button type="button" class="exit-popup__close" aria-label="Close" data-close>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d={CLOSE_X}></path>
      </svg>
    </button>

    {
      /* Trước đây `href="#"`: bấm vào ảnh quảng cáo chỉ đóng popup, không đi đâu —
        toàn bộ creative thành vô dụng. Nay dẫn ra đối tác như mọi nút affiliate
        khác. Giữ `data-close` để popup đóng lại sau khi mở tab mới, nếu không
        người dùng quay lại tab cũ vẫn thấy nó chắn màn hình. */
    }
    <a
      href={promoBrand.affiliateUrl}
      class="exit-popup__image-link"
      target="_blank"
      rel={AFFILIATE_REL}
      referrerpolicy="strict-origin"
      data-close
    >
      <Image src={promoPopup} alt="Special Promo Offer" class="exit-popup__image" />
    </a>
  </div>
</div>

<style>
  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .exit-popup[hidden] {
    display: none;
  }
  .exit-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5); /* darkened backdrop */
  }

  .exit-popup__box {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.25);
    width: 90%;
    max-width: 700px; /* Chuẩn kích thước popup */
    max-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }

  /* Nền trắng mờ + bóng chứ không phải chữ × trần: góc trên-phải của popup nằm đè
     lên ẢNH đối tác, mà ảnh đó thay đổi được — dấu × trần sẽ chìm nghỉm ngay khi
     ai đó đổi sang một creative có góc sáng. Cái đĩa trắng bảo đảm nó đọc được
     trên mọi ảnh. */
  .exit-popup__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 36px: ngưỡng vùng chạm tối thiểu. Nhỏ hơn thì trên điện thoại rất dễ bấm
       trượt ra ảnh — mà bấm ảnh cũng đóng, nên lỗi này im lặng ở desktop và chỉ
       lộ ra khi ảnh được đổi thành link thật. */
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .exit-popup__close:hover {
    background: #fff;
  }
  .exit-popup__close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .exit-popup__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .exit-popup__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
  }
</style>

<script>
  const popup = document.querySelector<HTMLElement>(".exit-popup");
  if (popup) {
    const COOKIE = "petsTablePopup";
    let shownThisPage = false;

    // Lưu bằng COOKIE PHIÊN (không đặt expires/max-age) → tự mất khi đóng trình duyệt.
    // Không còn khoá theo ngày: mỗi phiên hiện tối đa 1 lần.
    const seen = () => document.cookie.split("; ").some((c) => c.startsWith(COOKIE + "="));
    const markSeen = () => {
      document.cookie = COOKIE + "=1; path=/; SameSite=Lax";
    };

    const show = () => {
      if (shownThisPage || popup.hidden === false || seen()) return;
      shownThisPage = true;
      popup.hidden = false;
      markSeen();
    };
    const close = () => {
      popup.hidden = true;
      markSeen();
    };

    // Trigger 1: Hiện tự động sau 5 giây (5000 ms)
    setTimeout(() => {
      show();
    }, 5000);

    // Trigger 2: exit-intent (chuột rời qua mép trên cửa sổ)
    document.addEventListener("mouseout", (e) => {
      if (e.clientY <= 0 && !e.relatedTarget) show();
    });
    
    popup.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.hidden) close();
    });
  }
</script>
