---
import { Image } from "astro:assets";
import promoPopup from "@/assets/promos/promo-popup.webp";
---

{
  /* Popup exit-intent — hiện khi chuột rời mép trên cửa sổ
    (exit-intent). Xem/đóng rồi thì thôi tới hết PHIÊN. */
}
<div class="exit-popup" hidden>
  <div class="exit-popup__backdrop" data-close></div>
  <div class="exit-popup__box" role="dialog" aria-modal="true" aria-label="Promo offer">
    
    <a href="#" class="exit-popup__image-link" data-close>
      <Image src={promoPopup} alt="Special Promo Offer" class="exit-popup__image" />
    </a>
  </div>
</div>

<style>
  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .exit-popup[hidden] {
    display: none;
  }
  .exit-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5); /* darkened backdrop */
  }

  .exit-popup__box {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.25);
    width: 90%;
    max-width: 700px; /* Chuẩn kích thước popup */
    max-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }

  .exit-popup__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .exit-popup__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
  }
</style>

<script>
  const popup = document.querySelector<HTMLElement>(".exit-popup");
  if (popup) {
    const COOKIE = "petsTablePopup";
    let shownThisPage = false;

    // Lưu bằng COOKIE PHIÊN (không đặt expires/max-age) → tự mất khi đóng trình duyệt.
    // Không còn khoá theo ngày: mỗi phiên hiện tối đa 1 lần.
    const seen = () => document.cookie.split("; ").some((c) => c.startsWith(COOKIE + "="));
    const markSeen = () => {
      document.cookie = COOKIE + "=1; path=/; SameSite=Lax";
    };

    const show = () => {
      if (shownThisPage || popup.hidden === false || seen()) return;
      shownThisPage = true;
      popup.hidden = false;
      markSeen();
    };
    const close = () => {
      popup.hidden = true;
      markSeen();
    };

    // Trigger 1: Hiện tự động sau 5 giây (5000 ms)
    setTimeout(() => {
      show();
    }, 5000);

    // Trigger 2: exit-intent (chuột rời qua mép trên cửa sổ)
    document.addEventListener("mouseout", (e) => {
      if (e.clientY <= 0 && !e.relatedTarget) show();
    });
    
    popup.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.hidden) close();
    });
  }
</script>
