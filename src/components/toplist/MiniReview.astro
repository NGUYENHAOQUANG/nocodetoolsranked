---
import { getEntry } from "astro:content";
import { AFFILIATE_REL } from "@/lib/links";
import type { ImageMetadata } from "astro";
import type { ToplistRow } from "@/lib/rankings";
import { STAR_OUTLINE } from "@/lib/icon-paths";
import MiniReviewCategories from "@/components/toplist/MiniReviewCategories.astro";

/** Một brand trong danh sách — dữ liệu xếp hạng ghép với nội dung bài review của nó */
export interface MiniReviewItem {
  brand: ToplistRow;
  categories: { title: string; icon: ImageMetadata; score: number; description: string }[];
  pros: string[];
  cons: string[];
  /** Chỉ hiện dưới 768px, trong drawer "Summary" */
  summary: string;
}

interface Props {
  /** Tiêu đề mục — RIÊNG từng ngách nên phải truyền vào, không tự lấy. */
  title: string;
  /**
   * N brand đầu bảng, KHÔNG phải một. Bản gốc lấy top-N của chính bảng xếp hạng
   * trang đó (theme của họ đặt `maxMiniReviewsPerPage`), nên thứ tự ở đây chính là
   * thứ tự bảng xếp hạng — nơi gọi cắt sẵn, component không tự quyết lấy mấy cái.
   */
  items: MiniReviewItem[];
}

const { title, items } = Astro.props;

const CHECK = "M186.301 339.893L96 249.461l-32 30.507L186.301 402 448 140.506 416 110z";
const CROSS =
  "M405 136.798L375.202 107 256 226.202 136.798 107 107 136.798 226.202 256 107 375.202 136.798 405 256 285.798 375.202 405 405 375.202 285.798 256z";

/* Sao và số lượt đánh giá là dữ liệu TUỲ CHỌN của dòng xếp hạng: chỉ khai khi có số
   thật (xem `content.config.ts`). Không có thì không vẽ, chứ không vẽ 0 sao hay
   "(undefined Reviews)".

   Bản gốc đặt dấu ngoặc KHÁC nhau ở hai bản (rộng bằng nhau nên rất dễ bỏ sót):
   desktop "(12,143 Reviews)", mobile "(12,143) Reviews". */
const rows = items.map((it) => ({
  ...it,
  starCount: it.brand.stars ?? 0,
  reviewsDesktop: it.brand.reviewsCount ? `(${it.brand.reviewsCount} Reviews)` : "",
  reviewsMobile: it.brand.reviewsCount ? `(${it.brand.reviewsCount}) Reviews` : "",
}));

/* Nhãn dùng chung toàn site, không đổi theo trang -> tự lấy thay vì truyền props. */
const labels = (await getEntry("labels", "labels"))!.data;
---

<section class="mini-review">
  <h2 class="mini-review__title">{title}</h2>

  {
    /* Mỗi brand là MỘT mục, và mỗi mục vẫn có đủ hai cây DOM. Không gộp hai cây:
      desktop có Pros/Cons, mobile thay bằng drawer "Summary" — nội dung khác nhau
      thật, không phải cùng nội dung sắp xếp lại. */
  }
  {
    rows.map((it) => (
      <div class="mini-review__item">
        {/* ===== Bản mobile (<768px, hoặc màn hình thấp <420px) ===== */}
        <div class="mini-review__mobile">
          <div class="mini-review__mobile-top">
            <div class="mini-review__mobile-logo-box">
              <img
                class="mini-review__mobile-logo"
                src={it.brand.logo.src}
                alt={it.brand.logoAlt}
                width="180"
                height="60"
              />
            </div>

            <div class="mini-review__mobile-rating">
              <div class="mini-review__rating-row">
                <div class="mini-review__stars" aria-hidden="true">
                  {Array.from({ length: it.starCount }, () => (
                    <svg viewBox="0 0 16 16" fill="currentColor">
                      <path d={STAR_OUTLINE} />
                    </svg>
                  ))}
                </div>
                <span class="mini-review__score">{it.brand.rating}</span>
              </div>
              <span class="mini-review__reviews">{it.reviewsMobile}</span>
            </div>

            <div class="mini-review__cta">
              <a
                class="mini-review__button"
                href={it.brand.href}
                title={labels.cta.visitSite}
                target="_blank"
                rel={AFFILIATE_REL}
                referrerpolicy="strict-origin"
              >
                {labels.cta.visitSite}
              </a>
            </div>
          </div>

          <MiniReviewCategories categories={it.categories} />

          <div class="mini-review__drawer">
            <button class="mini-review__drawer-button" type="button" aria-expanded="false">
              <span class="mini-review__drawer-title">{labels.heading.summaryDrawer}</span>
              <svg
                class="mini-review__drawer-icon"
                viewBox="0 0 512 512"
                fill="none"
                stroke="currentColor"
                stroke-width="48"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m112 184 144 144 144-144" />
              </svg>
            </button>
            <div class="mini-review__drawer-content">
              <p class="mini-review__drawer-text">{it.summary}</p>
            </div>
          </div>
        </div>

        {/* ===== Bản desktop (≥768px và cao ≥420px) ===== */}
        <div class="mini-review__desktop">
          <div class="mini-review__column mini-review__column--main">
            <div class="mini-review__header">
              <img
                class="mini-review__logo"
                src={it.brand.logo.src}
                alt={it.brand.logoAlt}
                width={it.brand.logo.width}
                height={it.brand.logo.height}
              />
              <div class="mini-review__rating">
                <div class="mini-review__rating-row">
                  <div class="mini-review__stars" aria-hidden="true">
                    {Array.from({ length: it.starCount }, () => (
                      <svg viewBox="0 0 16 16" fill="currentColor">
                        <path d={STAR_OUTLINE} />
                      </svg>
                    ))}
                  </div>
                  <span class="mini-review__score">{it.brand.rating}</span>
                </div>
                <span class="mini-review__reviews">{it.reviewsDesktop}</span>
              </div>
            </div>

            <MiniReviewCategories categories={it.categories} />
          </div>

          <div class="mini-review__column mini-review__column--aside">
            <div class="mini-review__proscons">
              <div class="mini-review__proscons-group">
                <h3 class="mini-review__proscons-title">
                  <svg
                    class="mini-review__proscons-icon"
                    viewBox="0 0 512 512"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={CHECK} />
                  </svg>
                  Pros
                </h3>
                <ul class="mini-review__proscons-list">
                  {it.pros.map((item) => (
                    <li class="mini-review__proscons-item">
                      <svg
                        class="mini-review__item-icon"
                        viewBox="0 0 512 512"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={CHECK} />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mini-review__proscons-group">
                <h3 class="mini-review__proscons-title">
                  {/* Bản gốc để icon "Cons" cố định 16px, còn icon "Pros" là 1em (20.8px) */}
                  <svg
                    class="mini-review__proscons-icon mini-review__proscons-icon--sm"
                    viewBox="0 0 512 512"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={CROSS} />
                  </svg>
                  Cons
                </h3>
                <ul class="mini-review__proscons-list">
                  {it.cons.map((item) => (
                    <li class="mini-review__proscons-item">
                      <svg
                        class="mini-review__item-icon"
                        viewBox="0 0 512 512"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={CROSS} />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mini-review__cta">
              <a
                class="mini-review__button"
                href={it.brand.href}
                title={labels.cta.visitSite}
                target="_blank"
                rel={AFFILIATE_REL}
                referrerpolicy="strict-origin"
              >
                {labels.cta.visitSite}
              </a>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  /* ==========================================================================
     Base = mobile. Bản gốc đổi desktop↔mobile theo CẢ chiều cao:
     mobile khi (max-height:419px) HOẶC (max-width:767px) → desktop là phần bù
     `(min-width:768px) and (min-height:420px)` (chính là mốc bản gốc dùng cho nút).
     ========================================================================== */
  .mini-review {
    /* Palette ô điểm của bản gốc */
    --score-high-color: #016630;
    --score-high-background: #c7fcd9;
    --score-medium-color: #894b00;
    --score-medium-background: #fbf9ad;
    --score-low-color: #6b7280;
    --score-low-background: #f3f4f6;

    display: flex;
    flex-direction: column;
    gap: 20px;
    /* Cách khối trên 40px: bản gốc là 30px (margin đáy "Best Overall", nằm gọn
       trong <main> vì bên đó <main> là flex item) + 10px margin-top của section
       này. Ở đây hai section là block cạnh nhau nên margin gộp → dồn về một bên. */
    margin: 40px 0 20px;
    /* Bản gốc đặt màu chữ này ở wrapper trang rồi cho kế thừa xuống */
    color: var(--color-text-body);
  }

  .mini-review__title {
    width: 100%;
    max-width: min(95dvw, var(--width-content));
    margin-inline: auto;
  }
  /* Rule trông thừa nhưng có tác dụng render: ::first-letter tách chữ cái đầu
     thành text run riêng, đổi shaping/subpixel của phần chữ còn lại */
  .mini-review__title::first-letter {
    text-transform: uppercase;
  }

  /* Vỏ bọc MỘT brand. Không tự vẽ gì — nó chỉ gom hai cây DOM của cùng một brand
     lại làm một flex item, để `gap` của `.mini-review` tách các brand với nhau
     thay vì tách mobile khỏi desktop. */
  .mini-review__item {
    display: contents;
  }

  .mini-review__desktop {
    display: none;
  }

  /* ----- Sao + điểm (dùng chung cho cả 2 bản) ----- */
  .mini-review__rating-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Sao VÀNG, không phải màu thương hiệu: đây là quy ước chấm sao chung của mọi
     nơi trên site (`ScoreRing`, card `/reviews/`) và của cả bản gốc. Dùng
     `--color-primary` ở đây là khối này lệch với ba chỗ kia mỗi lần đổi bảng màu. */
  .mini-review__stars {
    display: flex;
    gap: 0.125rem;
    color: #ffcd42;
  }
  .mini-review__stars svg {
    width: 1rem;
    height: 1rem;
  }
  .mini-review__score {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .mini-review__reviews {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  /* ----- Nút "Visit Site" (dùng chung) ----- */
  .mini-review__cta {
    position: relative;
    width: 100%;
    /* Phải là `height` chứ không chỉ `min-height`: nút con dùng height:100% nên
       cần mốc quy chiếu xác định — thiếu nó nút co lại còn 30px */
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mini-review__button {
    width: 100%;
    height: 100%;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1rem;
    letter-spacing: 0.02em;
    transition: all 0.2s linear;
  }

  /* ----- Thẻ mobile ----- */
  .mini-review__mobile {
    width: 100%;
    max-width: 95dvw;
    margin-inline: auto;
    overflow: hidden;
    background: #f9f9f9;
    border-radius: 0.5rem;
    box-shadow:
      0 0 3px var(--color-shadow),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .mini-review__mobile-top {
    padding: 1rem 1rem 1.5rem;
  }
  .mini-review__mobile-logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mini-review__mobile-logo {
    max-width: 200px;
    max-height: 100px;
    object-fit: contain;
  }
  .mini-review__mobile-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  /* ----- Hạng mục chấm điểm ----- */

  /* ----- Drawer "Summary" (chỉ có ở bản mobile) ----- */
  .mini-review__drawer {
    width: 95%;
    margin-inline: auto;
    padding: 1rem;
    border-top: 1px solid #e5e7eb;
  }
  .mini-review__drawer-button {
    /* Bản gốc không reset <button> nên nút này giữ font mặc định của trình duyệt
       (Chrome: Arial 13.333px / line-height normal) thay vì kế thừa font trang.
       `revert` trả về đúng giá trị UA, khỏi hard-code Arial — bỏ đi thì chữ
       "Summary" cao 23.8px thay vì 20px và nút lệch 3.8px. */
    font: revert;
    width: 100%;
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    text-align: left;
    color: var(--color-text);
    transition: all 0.2s ease;
  }
  .mini-review__drawer-title {
    font-size: 1.2rem;
    font-weight: 500;
  }
  .mini-review__drawer-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }
  .mini-review__drawer-content {
    max-height: 0;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .mini-review__drawer-content.is-open {
    max-height: 500px;
    margin-top: 0.5rem;
    border-radius: 8px;
  }
  .mini-review__drawer-text {
    padding: 1rem;
    background-color: var(--color-surface);
    border-radius: 8px;
    box-shadow: 0 1px 3px var(--color-shadow);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ==========================================================================
     ≥481px (và cao ≥420px) — bản mobile nới padding
     ========================================================================== */
  @media (min-width: 481px) and (min-height: 420px) {
    .mini-review__mobile-top {
      padding: 1.2rem 1.2rem 2rem;
    }
    /* Bản gốc gộp chung với .mini-review__categories; nửa kia nay nằm ở
       MiniReviewCategories.astro cùng giá trị. */
    .mini-review__drawer {
      padding: 1.2rem;
    }
  }

  /* ==========================================================================
     ≥615px — hiệu ứng hover (bản gốc chỉ bật từ mốc này)
     ========================================================================== */
  @media (min-width: 615px) {
    .mini-review__button:hover {
      background-color: var(--color-secondary);
    }
  }

  /* ==========================================================================
     Desktop ≥768px và cao ≥420px — 2 cột: nội dung | Pros/Cons + nút
     ========================================================================== */
  @media (min-width: 768px) and (min-height: 420px) {
    .mini-review__mobile {
      display: none;
    }

    .mini-review__desktop {
      display: flex;
      min-height: 320px;
      width: 100%;
      max-width: min(95dvw, var(--width-content));
      margin-inline: auto;
      overflow: hidden;
      /* Bản gốc đặt nền này ở cả 2 cột — gộp lên thẻ vì kết quả như nhau */
      background: #f8f9fa;
      border-radius: 5px;
      box-shadow:
        0 4px 6px -1px var(--color-shadow),
        0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .mini-review__column {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 1.4rem 1.25rem;
    }
    .mini-review__column--main {
      flex: 2 1 0%;
    }
    .mini-review__column--aside {
      flex: 1 1 0%;
    }

    .mini-review__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }
    .mini-review__logo {
      width: 150px;
      height: auto;
      max-height: 80px;
      object-fit: contain;
    }
    .mini-review__rating {
      display: flex;
      flex-direction: column;
      text-align: right;
    }
    .mini-review__rating-row {
      justify-content: flex-end;
    }
    .mini-review__score {
      font-size: 1.125rem;
    }
    .mini-review__reviews {
      font-size: 0.875rem;
    }

    /* ----- Pros / Cons ----- */
    .mini-review__proscons {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      flex: 1 1 0%;
    }
    .mini-review__proscons-group {
      display: flex;
      flex-direction: column;
    }
    .mini-review__proscons-title {
      margin: 0 0 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.3rem;
      font-weight: 600;
    }
    .mini-review__proscons-icon {
      width: 1em;
      height: 1em;
      flex-shrink: 0;
      align-self: center;
    }
    .mini-review__proscons-icon--sm {
      width: 16px;
      height: 16px;
    }
    .mini-review__proscons-list {
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 5px;
      background: var(--color-surface);
      border: 1px solid var(--color-shadow);
      border-radius: 8px;
    }
    .mini-review__proscons-item {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.9rem;
      line-height: 1.5em;
    }
    .mini-review__item-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      /* Bản gốc đẩy icon xuống 3px cho ngang hàng chữ */
      position: relative;
      top: 3px;
      color: var(--color-primary);
    }

    .mini-review__cta {
      height: auto;
      margin-top: auto;
    }
    .mini-review__button {
      min-height: 47px;
      font-size: 1.2rem;
      font-weight: 600;
    }
  }
</style>

<script>
  // Drawer "Summary" — bản gốc đổi hẳn icon (chevron xuống ↔ lên) chứ không xoay
  const CHEVRON_DOWN = "m112 184 144 144 144-144";
  const CHEVRON_UP = "m112 328 144-144 144 144";

  document.querySelectorAll<HTMLButtonElement>(".mini-review__drawer-button").forEach((button) => {
    /* Tìm theo khối cha chứ không dùng `nextElementSibling`: cách cũ gãy im
         lặng nếu về sau chèn thêm element nào vào giữa nút và phần nội dung. */
    const content = button
      .closest(".mini-review__drawer")
      ?.querySelector(".mini-review__drawer-content");
    const path = button.querySelector("path");
    if (!content || !path) return;

    button.addEventListener("click", () => {
      const open = content.classList.toggle("is-open");
      button.setAttribute("aria-expanded", String(open));
      path.setAttribute("d", open ? CHEVRON_UP : CHEVRON_DOWN);
    });
  });
</script>
