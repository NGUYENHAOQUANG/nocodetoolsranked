---
import { reviews } from "../data/reviews";
import ReviewCard from "./ReviewCard.astro";
---

<div class="reviews">
  {reviews.map((review) => <ReviewCard review={review} />)}
</div>

<style>
  .reviews {
    margin: 10px 0;
    display: flex;
    flex-flow: column;
    align-items: center;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .reviews {
      /* Bản gốc đổi sang inline-block ở desktop — card tự giãn hết bề ngang */
      display: inline-block;
      width: 97%;
      margin: 20px 15px;
    }
  }
</style>
