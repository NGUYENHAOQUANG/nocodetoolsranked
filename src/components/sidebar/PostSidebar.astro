---
import { Image } from "astro:assets";
import { getSidebarPartners } from "@/lib/rankings";
import { HOME } from "@/lib/links";

import { getRelatedPosts } from "@/lib/posts";

const sidebarPartners = await getSidebarPartners();

interface Props {
  /** id bài đang xem — 2 thẻ gợi ý lấy từ `relatedPosts` của chính bài đó */
  postId: string;
}

/* Sidebar bài blog = danh sách brand + "Compare All", rồi 2 thẻ "must reads".
   Không có carousel như trang review. Tên brand là <h4>, tiêu đề bài là <h6>
   (đúng thẻ bản gốc dùng). Thẻ "must reads" đổi theo từng bài: bài nào TỰ là
   must-read thì thay thẻ trỏ về chính nó bằng thẻ khác.

   ARTICLE_MAP hardcode trước đây đã bỏ — đó là nơi thứ SÁU khai cùng danh sách
   bài viết. Giờ lấy từ frontmatter `relatedPosts` (reference() nên gõ sai là
   lỗi build, không phải undefined âm thầm). */
const { postId } = Astro.props;
const articles = await getRelatedPosts(postId);

const FLOATING_ARROW_RIGHT =
  "M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z";
---

<div class="blog-sidebar">
  <div class="sidebar-partners">
    <div class="sidebar-partners__content">
      {
        sidebarPartners.map((p) => (
          <div class="sidebar-partners__node" data-href={p.href}>
            <div class="sidebar-partners__icon-wrap">
              <img
                class="sidebar-partners__icon"
                src={p.logo.src}
                alt={p.logoAlt}
                width="215"
                height="115"
              />
            </div>
            <div class="sidebar-partners__text">
              <h4 class="sidebar-partners__name">{p.name}</h4>
              <a class="sidebar-partners__link" href={p.href}>
                <div>Read review</div>
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <div class="sidebar-partners__compare">
      <a href={HOME}>
        Compare All
        <svg viewBox="0 0 320 512" width="1em" height="1em" aria-hidden="true">
          <path d={FLOATING_ARROW_RIGHT}></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="sidebar-articles">
    <div class="sidebar-articles__list">
      {
        articles.map((a) => (
          <div class="sidebar-articles__node">
            <a class="sidebar-articles__image" href={a.href}>
              <Image src={a.image} alt={a.imageAlt} width={a.image.width} height={a.image.height} />
            </a>
            <div class="sidebar-articles__content">
              <a class="sidebar-articles__title-link" href={a.href}>
                <h6 class="sidebar-articles__title">{a.title}</h6>
              </a>
              <a class="sidebar-articles__link" href={a.href}>Read more</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* ===== Danh sách brand — mặc định MOBILE (<481px) ===== */
  .sidebar-partners {
    width: 100%;
    max-width: 600px;
    height: max-content;
    margin: auto auto 20px;
    padding: 10px;
    display: flex;
    flex-flow: column;
    align-items: center;
    background-color: #f5f5f5;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
  }
  .sidebar-partners * {
    transition: 0.2s linear;
  }
  .sidebar-partners__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .sidebar-partners__node {
    width: 100%;
    height: max-content;
    padding: 10px 0;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 10px;
    border-bottom: 1px solid rgba(160, 160, 160, 0.576);
    cursor: pointer;
  }
  .sidebar-partners__icon-wrap {
    flex: 1 1 0%;
    height: 100%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sidebar-partners__icon {
    max-width: 100px;
    max-height: 70px;
    margin: auto;
    object-fit: contain;
  }
  .sidebar-partners__text {
    flex: 1 1 0%;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-evenly;
  }
  .sidebar-partners__name {
    margin: 0;
    color: #2d2d2d;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .sidebar-partners__link {
    --hover-color: var(--color-primary);

    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .sidebar-partners__link div {
    font-weight: 400;
  }

  .sidebar-partners__compare {
    --hover-bg-color: var(--color-secondary);

    position: relative;
    width: max-content;
    min-width: 180px;
    height: max-content;
    min-height: 55px;
    margin: 10px auto;
    padding: 12px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: #fff;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .sidebar-partners__compare a {
    background-color: inherit;
    color: inherit;
    font-weight: 600;
    transition: none;
  }
  .sidebar-partners__compare svg {
    position: absolute;
    top: calc(50% + 2px);
    right: 10px;
    opacity: 0;
    font-size: 1rem;
    fill: currentColor;
    transform: translateY(-50%);
    transition: 0.2s ease-in-out;
  }

  /* ===== Thẻ bài viết ===== */
  .sidebar-articles {
    max-width: 600px;
    margin: 20px auto;
    padding: 10px;
    background-color: #f5f5f5;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }
  .sidebar-articles__node {
    width: 100%;
    margin: 10px auto 30px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sidebar-articles__image {
    position: relative;
    width: 100%;
    height: calc(100% - 30px);
    margin: auto;
    display: flex;
    flex-shrink: 0;
    background-color: var(--color-primary);
  }
  .sidebar-articles__image :global(img) {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    transition: 0.2s linear;
  }
  .sidebar-articles__image :global(img):hover {
    opacity: 0.8;
  }
  .sidebar-articles__content {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }
  .sidebar-articles__title-link {
    --hover-color: var(--color-primary);
  }
  .sidebar-articles__title {
    position: relative;
    top: -1px;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.15rem;
  }
  .sidebar-articles__link {
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 400;
  }
  .sidebar-articles__link:hover {
    opacity: 0.5;
  }

  /* ===== ≥481px: brand thành lưới 3 cột ===== */
  @media (min-width: 481px) and (min-height: 420px) {
    .sidebar-partners {
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .sidebar-partners__content {
      width: 100%;
      height: 100%;
      flex-flow: wrap;
      justify-content: space-between;
      gap: 10px;
    }
    .sidebar-partners__node {
      width: 30%;
      height: auto;
      padding: 10px 0;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border: none;
    }
    .sidebar-partners__icon {
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
    }
    .sidebar-partners__compare {
      min-width: 40%;
    }
  }

  /* ===== ≥768px: thẻ bài viết thành lưới 2 cột ===== */
  @media (min-width: 768px) and (min-height: 420px) {
    .sidebar-articles__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 783–1039px chỉ hiện 3 brand (bản gốc đo clientWidth 768–1024) */
  @media (min-width: 783px) and (max-width: 1039px) and (min-height: 420px) {
    .sidebar-partners__node:nth-child(n + 4) {
      display: none;
    }
  }

  /* ===== ≥1025px: sidebar 1 cột hẹp ===== */
  @media (min-width: 1025px) and (min-height: 420px) {
    .sidebar-partners {
      max-width: 250px;
      margin-right: 0;
      margin-bottom: 20px;
    }
    .sidebar-partners__content {
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .sidebar-partners__node {
      width: 100%;
      height: max-content;
      padding: 10px 0;
      flex-direction: row;
      align-items: flex-start;
      gap: 10px;
    }
    .sidebar-partners__node:not(:last-of-type) {
      border-bottom: 1px solid rgba(160, 160, 160, 0.576);
    }
    .sidebar-partners__icon {
      width: 100%;
      height: 100%;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sidebar-partners__text {
      line-height: 1.5rem;
    }
    .sidebar-partners__name {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.25rem;
    }
    .sidebar-partners__link div {
      font-weight: unset;
    }
    .sidebar-partners__compare {
      min-width: max(50%, 147px);
      min-height: unset;
      padding: 5px;
    }
    .sidebar-partners__compare a {
      font-weight: unset;
    }
    .sidebar-partners__compare:hover svg {
      opacity: 1;
      right: 2%;
    }
    .sidebar-articles {
      max-width: 250px;
      margin: 0 0 0 auto;
      display: flex;
      flex-direction: column;
    }
    .sidebar-articles__list {
      display: initial;
    }
    .sidebar-articles__node {
      margin-bottom: 20px;
    }
    .sidebar-articles__title {
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.2rem;
    }
    .sidebar-articles__link {
      font-size: 0.9375rem;
    }
  }

  /* ===== ≥615px — hover ===== */
  @media (min-width: 615px) {
    .sidebar-partners__link div:hover {
      color: var(--hover-color);
    }
    .sidebar-partners__compare:hover {
      background-color: var(--hover-bg-color);
    }
    .sidebar-articles__title-link:hover {
      color: var(--hover-color);
    }
  }
</style>

<script>
  /* Cả hàng brand click được (trừ khi bấm đúng link "Read review" bên trong) */
  document.querySelectorAll<HTMLElement>(".blog-sidebar .sidebar-partners__node").forEach((node) => {
    node.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) return;
      const href = node.dataset.href;
      if (href) window.location.href = href;
    });
  });
</script>
