---
import { Image } from "astro:assets";
import { getReviewSidebarArticles } from "@/lib/posts";
import { getCarouselPartners, getSidebarPartners } from "@/lib/rankings";

const carouselPartners = await getCarouselPartners();
const sidebarPartners = await getSidebarPartners();
const sidebarArticles = await getReviewSidebarArticles();

interface Props {
  /** Key đối tác của trang hiện tại — quyết định slide bắt đầu của carousel */
  partner: string;
}

const { partner } = Astro.props;

/* Carousel duyệt qua ĐỦ 6 đối tác, bắt đầu ở đối tác của trang hiện tại. */
const startIndex = Math.max(
  0,
  carouselPartners.findIndex((p) => p.key === partner),
);
const current = carouselPartners[startIndex];
/* Dữ liệu cho JS client: chỉ cần src ảnh (đã bundle) + text + link */
const slides = carouselPartners.map((p) => ({
  logoSrc: p.logo.src,
  logoAlt: p.logoAlt,
  promo: p.promo,
  href: p.href,
}));

/* Mũi tên tròn của carousel — path lấy thẳng từ DOM gốc (viewBox 512, không phải
   chevron trần viewBox 320) */
const CIRCLE_ARROW_LEFT =
  "M256 48C141.1 48 48 141.1 48 256s93.1 208 208 208 208-93.1 208-208S370.9 48 256 48zm43.4 289.1c7.5 7.5 7.5 19.8 0 27.3-3.8 3.8-8.7 5.6-13.6 5.6s-9.9-1.9-13.7-5.7l-94-94.3c-6.9-7.6-6.7-19.3.6-26.6l95.4-95.7c7.5-7.5 19.7-7.6 27.3 0 7.5 7.5 7.6 19.7 0 27.3l-81.9 81 79.9 81.1z";
const CIRCLE_ARROW_RIGHT =
  "M48 256c0 114.9 93.1 208 208 208s208-93.1 208-208S370.9 48 256 48 48 141.1 48 256zm244.5 0l-81.9-81.1c-7.5-7.5-7.5-19.8 0-27.3s19.8-7.5 27.3 0l95.4 95.7c7.3 7.3 7.5 19.1.6 26.6l-94 94.3c-3.8 3.8-8.7 5.7-13.7 5.7-4.9 0-9.9-1.9-13.6-5.6-7.5-7.5-7.6-19.7 0-27.3l79.9-81z";
/* Mũi tên trượt ra khi hover nút CTA (ẩn sẵn, opacity 0) */
const FLOATING_ARROW_RIGHT =
  "M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z";
---

<div class="review-sidebar">
  {/* Carousel duyệt qua đủ 6 đối tác (bắt đầu ở đối tác trang hiện tại). Mũi tên
      trái disable khi ở slide đầu, mũi tên phải disable khi ở slide cuối. Nội dung
      được JS đổi tại chỗ (bản gốc cũng chỉ giữ 1 slide trong DOM, đổi nội dung). */}
  <div class="promo-carousel" data-index={startIndex} data-slides={JSON.stringify(slides)}>
    <div class="promo-carousel__viewport">
      <div class="promo-carousel__slide">
        <a
          class="promo-carousel__link"
          href={current.href}
          target="_blank"
          rel="noopener nofollow"
          referrerpolicy="strict-origin"
        >
          <img
            class="promo-carousel__logo"
            src={current.logo.src}
            alt={current.logoAlt}
            width="215"
            height="115"
          />
          <p class="promo-carousel__promo">{current.promo}</p>
          {/* Ô bọc nút: margin auto canh giữa nút (cao 40px) trong hàng grid cao
              72.8px — thiếu ô này nút bị kéo giãn hết hàng */}
          <div class="promo-carousel__cta">
            <span class="promo-carousel__button">
              View Rates
              <svg viewBox="0 0 320 512" width="1em" height="1em" aria-hidden="true">
                <path d={FLOATING_ARROW_RIGHT}></path>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
    <div class="promo-carousel__controls">
      <div
        class:list={["promo-carousel__arrow promo-carousel__arrow--left", { "is-disabled": startIndex === 0 }]}
        data-dir="-1"
      >
        <svg viewBox="0 0 512 512" width="25" height="25" aria-hidden="true">
          <path d={CIRCLE_ARROW_LEFT}></path>
        </svg>
      </div>
      <div
        class:list={[
          "promo-carousel__arrow promo-carousel__arrow--right",
          { "is-disabled": startIndex === slides.length - 1 },
        ]}
        data-dir="1"
      >
        <svg viewBox="0 0 512 512" width="25" height="25" aria-hidden="true">
          <path d={CIRCLE_ARROW_RIGHT}></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="sidebar-partners">
    <div class="sidebar-partners__content">
      {
        sidebarPartners.map((p) => (
          <div class="sidebar-partners__node" data-href={p.href}>
            <div class="sidebar-partners__icon-wrap">
              <img
                class="sidebar-partners__icon"
                src={p.logo.src}
                alt={p.logoAlt}
                width="215"
                height="115"
              />
            </div>
            <div class="sidebar-partners__text">
              <p class="sidebar-partners__name">{p.name}</p>
              <a class="sidebar-partners__link" href={p.href}>
                <div>Read review</div>
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <div class="sidebar-partners__compare">
      <a href="/">
        Compare All
        <svg viewBox="0 0 320 512" width="1em" height="1em" aria-hidden="true">
          <path d={FLOATING_ARROW_RIGHT}></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="sidebar-articles">
    <div class="sidebar-articles__list">
      {
        sidebarArticles.map((a) => (
          <div class="sidebar-articles__node">
            <a class="sidebar-articles__image" href={a.href}>
              {/* Giữ đúng tỉ lệ ảnh gốc: 2 ảnh 600×400 và 1 ảnh 597×400 nên thẻ
                  thứ 3 cao lệch nhẹ — bản gốc cũng vậy */}
              <Image src={a.image} alt={a.imageAlt} width={a.image.width} height={a.image.height} />
            </a>
            {/* Tiêu đề + link nằm trong 1 ô bọc: node chỉ có 2 con nên chỉ có 1
                gap. Để 3 con ngang cấp là thừa 1 gap → mỗi thẻ dư đúng 10px. */}
            <div class="sidebar-articles__content">
              <a class="sidebar-articles__title-link" href={a.href}>
                <p class="sidebar-articles__title">{a.title}</p>
              </a>
              <a class="sidebar-articles__link" href={a.href}>Read more</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* ===== Carousel khuyến mãi — chỉ hiện từ 1025px ===== */
  .promo-carousel {
    display: none;
    flex-direction: column;
    width: 100%;
    max-width: 250px;
    height: 300px;
    min-height: fit-content;
    margin-left: auto;
    margin-bottom: 15px;
    overflow: hidden;
    /* Bản gốc khai #e8e8e8 trong CSS module nhưng ghi đè bằng style inline
       #f5f5f5 → trang chạy thật là #f5f5f5 */
    background-color: #f5f5f5;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
  }
  .promo-carousel__viewport {
    width: 100%;
    height: 100%;
    margin: auto;
    display: flex;
  }
  .promo-carousel__slide {
    position: relative;
    width: 100%;
    padding: 10px;
    /* Mờ dần khi đổi đối tác (bản gốc dùng framer-motion fade opacity) */
    transition: opacity 0.15s linear;
  }
  .promo-carousel__slide.is-switching {
    opacity: 0;
  }
  .promo-carousel__link {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr;
    justify-content: space-between;
    justify-items: center;
  }
  .promo-carousel__logo {
    height: 100px;
    max-width: 140px;
    max-height: 100px;
    object-fit: contain;
  }
  .promo-carousel__promo {
    margin: 0 auto;
    padding: 0;
    color: #2d2d2d;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }
  .promo-carousel__cta {
    position: relative;
    width: 100%;
    min-width: 157px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .promo-carousel__button {
    --hover-bg-color: var(--color-secondary);

    position: relative;
    width: max-content;
    min-width: 150px;
    max-width: 80%;
    height: 100%;
    min-height: 40px;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.02em;
    transition: 0.2s linear;
  }
  .promo-carousel__controls {
    height: 30px;
    width: max-content;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }
  .promo-carousel__arrow svg {
    fill: #858585;
    cursor: pointer;
  }
  /* Chỉ 1 slide → mũi tên trái luôn mờ, không bấm được */
  .promo-carousel__arrow.is-disabled svg {
    fill: #d3d3d3;
    cursor: default;
  }

  /* Mũi tên trượt ra khi hover nút CTA */
  .promo-carousel__button svg,
  .sidebar-partners__compare svg {
    position: absolute;
    top: calc(50% + 2px);
    right: 10px;
    opacity: 0;
    font-size: 1rem;
    fill: currentColor;
    transform: translateY(-50%);
    transition: 0.2s ease-in-out;
  }

  /* ===== Danh sách brand — mặc định là bản MOBILE (<481px), các mốc min-width
     bên dưới chồng lên đúng như bản gốc ===== */
  .sidebar-partners {
    width: 100%;
    max-width: 600px;
    height: max-content;
    margin: auto auto 20px;
    padding: 10px;
    display: flex;
    flex-flow: column;
    align-items: center;
    /* Không có trong CSS module, bản gốc đặt bằng style inline */
    background-color: #f5f5f5;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
  }
  .sidebar-partners * {
    transition: 0.2s linear;
  }
  .sidebar-partners__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .sidebar-partners__node {
    width: 100%;
    height: max-content;
    padding: 10px 0;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 10px;
    border-bottom: 1px solid rgba(160, 160, 160, 0.576);
    cursor: pointer;
  }
  .sidebar-partners__icon-wrap {
    flex: 1 1 0%;
    height: 100%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sidebar-partners__icon {
    max-width: 100px;
    max-height: 70px;
    margin: auto;
    object-fit: contain;
  }
  .sidebar-partners__text {
    flex: 1 1 0%;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-evenly;
  }
  .sidebar-partners__name {
    margin: 0;
    color: #2d2d2d;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .sidebar-partners__link {
    --hover-color: var(--color-primary);

    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .sidebar-partners__link div {
    font-weight: 400;
  }

  .sidebar-partners__compare {
    --hover-bg-color: var(--color-secondary);

    position: relative;
    width: max-content;
    min-width: 180px;
    height: max-content;
    min-height: 55px;
    margin: 10px auto;
    padding: 12px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--color-primary);
    color: #fff;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .sidebar-partners__compare a {
    background-color: inherit;
    color: inherit;
    font-weight: 600;
    transition: none;
  }

  /* ===== Thẻ bài viết ===== */
  .sidebar-articles {
    max-width: 600px;
    margin: 20px auto;
    padding: 10px;
    background-color: #f5f5f5;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }
  .sidebar-articles__node {
    width: 100%;
    margin: 10px auto 30px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sidebar-articles__image {
    position: relative;
    width: 100%;
    height: calc(100% - 30px);
    margin: auto;
    display: flex;
    flex-shrink: 0;
    /* Chỉ ló ra lúc ảnh chưa tải xong — bản gốc vẫn đặt */
    background-color: var(--color-primary);
  }
  .sidebar-articles__image :global(img) {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    transition: 0.2s linear;
  }
  .sidebar-articles__image :global(img):hover {
    opacity: 0.8;
  }
  .sidebar-articles__content {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }
  .sidebar-articles__title-link {
    --hover-color: var(--color-primary);
  }
  .sidebar-articles__title {
    position: relative;
    top: -1px;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.15rem;
  }
  .sidebar-articles__link {
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 400;
  }
  .sidebar-articles__link:hover {
    opacity: 0.5;
  }

  /* ===== ≥481px: danh sách brand chuyển thành lưới 3 cột tự xuống hàng ===== */
  @media (min-width: 481px) and (min-height: 420px) {
    .sidebar-partners {
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .sidebar-partners__content {
      width: 100%;
      height: 100%;
      flex-flow: wrap;
      justify-content: space-between;
      /* Mốc 1025 KHÔNG bỏ gap này đi — thiếu 5 gap thì khung hụt đúng 50px */
      gap: 10px;
    }
    .sidebar-partners__node {
      width: 30%;
      height: auto;
      padding: 10px 0;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border: none;
    }
    .sidebar-partners__icon {
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
    }
    .sidebar-partners__compare {
      min-width: 40%;
    }
  }

  /* ===== ≥768px: thẻ bài viết thành lưới 2 cột ===== */
  @media (min-width: 768px) and (min-height: 420px) {
    .sidebar-articles__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Bản gốc chỉ render 3 brand khi `clientWidth` trong khoảng 768–1024 (JS đo
     clientWidth, đã trừ thanh cuộn 15px) → mốc CSS tương ứng là 783–1039. */
  @media (min-width: 783px) and (max-width: 1039px) and (min-height: 420px) {
    .sidebar-partners__node:nth-child(n + 4) {
      display: none;
    }
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .promo-carousel {
      display: flex;
    }
    .sidebar-partners {
      max-width: 250px;
      margin-right: 0;
      margin-bottom: 20px;
    }
    .sidebar-partners__content {
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .sidebar-partners__node {
      width: 100%;
      height: max-content;
      padding: 10px 0;
      flex-direction: row;
      align-items: flex-start;
      gap: 10px;
    }
    .sidebar-partners__node:not(:last-of-type) {
      border-bottom: 1px solid rgba(160, 160, 160, 0.576);
    }
    /* Bắt buộc: thiếu 2 dòng này ảnh ăn theo thuộc tính width/height rồi bị
       max-height kẹp ở 70px → node cao 91px thay vì để phần chữ quyết định */
    .sidebar-partners__icon {
      width: 100%;
      height: 100%;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sidebar-partners__text {
      line-height: 1.5rem;
    }
    .sidebar-partners__name {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.25rem;
    }
    .sidebar-partners__link div {
      font-weight: unset;
    }
    .sidebar-partners__compare {
      min-width: max(50%, 147px);
      min-height: unset;
      padding: 5px;
    }
    .sidebar-partners__compare a {
      font-weight: unset;
    }
    .sidebar-partners__compare:hover svg {
      opacity: 1;
      right: 2%;
    }
    .sidebar-articles {
      max-width: 250px;
      margin: 0 0 0 auto;
      display: flex;
      flex-direction: column;
    }
    .sidebar-articles__list {
      display: initial;
    }
    .sidebar-articles__node {
      margin-bottom: 20px;
    }
    .sidebar-articles__title {
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.2rem;
    }
    .sidebar-articles__link {
      font-size: 0.9375rem;
    }
  }

  /* ===== ≥615px — hiệu ứng hover (bản gốc chỉ bật từ mốc này) ===== */
  @media (min-width: 615px) {
    .promo-carousel__arrow:not(.is-disabled):hover svg {
      fill: var(--color-primary);
    }
    .promo-carousel__promo:hover {
      color: var(--color-primary);
    }
    .promo-carousel__button:hover {
      background-color: var(--hover-bg-color);
    }
    .promo-carousel__button:hover svg {
      opacity: 1;
      right: 3%;
    }
    .sidebar-partners__link div:hover {
      color: var(--hover-color);
    }
    .sidebar-partners__compare:hover {
      background-color: var(--hover-bg-color);
    }
    .sidebar-articles__title-link:hover {
      color: var(--hover-color);
    }
  }
</style>

<script>
  /* Bản gốc để cả hàng brand click được (div + onClick, không phải thẻ <a> vì bên
     trong đã có link "Read review") */
  document.querySelectorAll<HTMLElement>(".sidebar-partners__node").forEach((node) => {
    node.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) return;
      const href = node.dataset.href;
      if (href) window.location.href = href;
    });
  });

  /* Carousel khuyến mãi: duyệt qua 6 đối tác. Đổi nội dung slide tại chỗ (như bản
     gốc) + bật/tắt disable hai mũi tên ở hai đầu danh sách. */
  interface Slide {
    logoSrc: string;
    logoAlt: string;
    promo: string;
    href: string;
  }
  document.querySelectorAll<HTMLElement>(".promo-carousel").forEach((carousel) => {
    const slides: Slide[] = JSON.parse(carousel.dataset.slides || "[]");
    let index = Number.parseInt(carousel.dataset.index || "0", 10);
    const slide = carousel.querySelector<HTMLElement>(".promo-carousel__slide");
    const logo = carousel.querySelector<HTMLImageElement>(".promo-carousel__logo");
    const promo = carousel.querySelector<HTMLElement>(".promo-carousel__promo");
    const link = carousel.querySelector<HTMLAnchorElement>(".promo-carousel__link");
    const leftArrow = carousel.querySelector<HTMLElement>(".promo-carousel__arrow--left");
    const rightArrow = carousel.querySelector<HTMLElement>(".promo-carousel__arrow--right");
    if (!slide || !logo || !promo || !link || !leftArrow || !rightArrow || slides.length < 2) return;

    const render = () => {
      const p = slides[index];
      logo.src = p.logoSrc;
      logo.alt = p.logoAlt;
      promo.textContent = p.promo;
      link.href = p.href;
      leftArrow.classList.toggle("is-disabled", index === 0);
      rightArrow.classList.toggle("is-disabled", index === slides.length - 1);
    };
    const go = (dir: number) => {
      const next = index + dir;
      if (next < 0 || next >= slides.length) return;
      index = next;
      slide.classList.add("is-switching");
      window.setTimeout(() => {
        render();
        slide.classList.remove("is-switching");
      }, 150);
    };
    leftArrow.addEventListener("click", () => go(-1));
    rightArrow.addEventListener("click", () => go(1));
  });
</script>
