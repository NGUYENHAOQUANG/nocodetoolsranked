---
/**
 * Banner đầu trang cho MỌI trang trong: chỉ có tiêu đề, không phụ đề, không
 * "Last Updated", không tooltip disclosure.
 *
 * Tách khỏi `HeroToplist` vì hai thứ chỉ dùng chung `<section class="hero">` và bộ
 * ảnh nền. `title` và `alt` để BẮT BUỘC: bản gộp trước đây mặc định `title = ""`
 * nên quên truyền là ra banner rỗng mà `astro check` vẫn xanh.
 *
 * Khung dùng chung nằm ở `@/styles/hero.css`.
 */
import { getImage } from "astro:assets";
import heroWide from "@/assets/heroes/banner-new.webp";
import heroCompact from "@/assets/heroes/banner-new.webp";
import "@/styles/hero.css";

interface Props {
  /** Tiêu đề bản desktop */
  title: string;
  /** Tiêu đề bản mobile (<768px). Bản gốc để chuỗi KHÁC hẳn desktop ở vài trang. */
  mobileTitle?: string;
  /** Căn tiêu đề LÊN ĐẦU banner thay vì giữa (các trang nội dung phẳng) */
  isTitleTop?: boolean;
  alt: string;
}

const { title, mobileTitle = title, isTitleTop = false, alt } = Astro.props;

/* Chỉ dựng hai nhánh chữ khi hai chuỗi KHÁC nhau. Giống nhau mà vẫn dựng hai nhánh
   thì mỗi trang ship tiêu đề hai lần, một bản không bao giờ hiện. */
const hasTwoTitles = mobileTitle !== title;

/* HAI ảnh THẬT SỰ KHÁC NHAU, đổi ở mốc 768px — đây là art direction thật, không
   phải cùng một ảnh hai cỡ:
   - `banner.webp`  3800x520, dải rất dẹt, dùng từ 768px;
   - `compact.webp` 650x325, khung gần vuông hơn, dùng dưới 768px.
   Đo trên bản gốc: dưới 768px nó phát file 650x325 (`object-position: 100% 50%`),
   từ 768px đổi sang 3800x520 (`100% 0%`).

   Bản gốc đổi ảnh bằng JS đọc `clientWidth` còn CSS ẩn theo `innerWidth`, lệch
   đúng 15px thanh cuộn nên ở 768-782px KHÔNG ảnh nào hiện (đo lại hôm nay: banner
   cao 0px ở đúng 768). `<picture>` + `<source media>` xử lý cùng một việc bằng CSS
   thuần nên không có khe hở đó, và trình duyệt chỉ TẢI ảnh nó chọn.

   Astro KHÔNG có component làm art direction (`<Picture>` chỉ đổi ĐỊNH DẠNG của
   cùng một ảnh), nên phải ghép tay bằng `getImage()`. */
const wide = await getImage({
  src: heroWide,
  widths: [768, 1024, 1440, 1920, 2560],
  format: "webp",
});
const compact = await getImage({
  src: heroCompact,
  widths: [375, 480, 650],
  format: "webp",
});

const innerContentClass = [
  "hero__content",
  "hero__content--inner",
  isTitleTop && "hero__content--top",
]
  .filter(Boolean)
  .join(" ");
---

<section class="hero">
  {
    /* MỘT banner, MỘT `<h1>` — cùng hình dạng với `HeroToplist`.

      Bản gốc dựng hai cây banner riêng, JS chọn cây theo `clientWidth` (mốc
      768) còn CSS ẩn theo `innerWidth` — lệch đúng 15px thanh cuộn, nên ở
      768-782px KHÔNG cây nào hiện: dải trắng 170px, không tiêu đề nào. 768px
      là bề rộng iPad dọc, nên đó là lỗi thật chứ không phải thiết kế.

      Hai cây còn kéo theo HAI thẻ `<h1>` trên mỗi trang trong — 20/21 trang,
      trái chính luật repo tự ghi. Gộp lại xử lý cả hai: ảnh và chữ đổi theo
      CÙNG một mốc, và chỉ còn một `<h1>` chứa hai nhánh chữ. */
  }
  <div class="hero__banner">
    {
      /* MỘT `alt` cho cả hai nhánh: `<picture>` chỉ có một `<img>`. Chuỗi này mô tả
        trang, còn chuỗi mobile của bản gốc chỉ khác ở vài trang và không nói thêm gì
        về ẢNH. `width`/`height` lấy theo ảnh MOBILE vì đó là ảnh của `<img>`. */
    }
    <picture>
      <source media="(min-width: 768px)" srcset={wide.srcSet.attribute} sizes="100vw" />
      <img
        class="hero__bg"
        src={compact.src}
        srcset={compact.srcSet.attribute}
        sizes="100vw"
        alt={alt}
        width="650"
        height="325"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class={innerContentClass}>
      <div class="hero__text">
        {
          /* set:html để tiêu đề mobile chèn được `<br>` CỨNG như bản gốc, thay vì
            phó mặc cho chỗ tự wrap. Hầu hết trang giờ dùng một chuỗi cho cả hai
            nhánh; trường `mobileTitle` giữ lại cho trang nào cần ngắt dòng riêng.
            Nhánh nào bị `display: none` thì trình đọc màn hình cũng bỏ qua, nên
            một `<h1>` vẫn cho ra đúng một tiêu đề được đọc. */
        }
        <h1 class="hero__title">
          {
            hasTwoTitles ? (
              <Fragment>
                <span class="hero__title-part hero__title-part--compact" set:html={mobileTitle} />
                <span class="hero__title-part hero__title-part--wide" set:html={title} />
              </Fragment>
            ) : (
              <span set:html={title} />
            )
          }
        </h1>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bản gốc chỉ đổi justify-content: trang chủ đẩy "Last Updated" xuống đáy
     (space-between), trang trong căn giữa tiêu đề. Padding đối xứng nên tâm
     tiêu đề rơi đúng giữa banner. */
  .hero__content--inner {
    justify-content: center;
  }
  /* Trang 404: tiêu đề căn LÊN ĐẦU (bản gốc dùng space-between/flex-start,
     một con nên nằm sát trên) — đè lên căn-giữa của --inner */
  .hero__content--top {
    justify-content: flex-start;
  }

  /* `<picture>` phải RA KHỎI luồng, đúng như `<img>` khi đứng một mình.

     `display: contents` KHÔNG dùng được: `.hero__banner` là grid, nên nó đưa
     `<img>` lên làm grid item và sinh thêm một hàng — đo được `grid-template-rows`
     thành `54.72px 117.28px`, đẩy tiêu đề xuống 54.7px và làm mất tác dụng của
     `--top`. Cho `<picture>` absolute thì grid lại chỉ còn đúng một item trong luồng. */
  picture {
    position: absolute;
    inset: 0;
  }

  /* Chữ đổi ở mốc 768px — CÙNG mốc mà `<source media>` dùng cho ảnh. */
  .hero__title-part--wide {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__title-part--compact {
      display: none;
    }
    .hero__title-part--wide {
      display: inline;
    }
  }
</style>
