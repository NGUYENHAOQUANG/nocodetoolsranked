---
import { Image } from "astro:assets";
import dog from "@/assets/images/popup-pets-dog.png";
import discount from "@/assets/images/popup-pets-discount.png";
import logo from "@/assets/images/popup-pets-logo.svg";
---

{/* Popup exit-intent "The Pet's Table" — hiện khi chuột rời mép trên cửa sổ
    (exit-intent). Xem/đóng rồi thì thôi tới hết PHIÊN (lưu cookie phiên petsTablePopup). */}
<div class="exit-popup" hidden>
  <div class="exit-popup__backdrop" data-close></div>
  <div class="exit-popup__box" role="dialog" aria-modal="true" aria-label="The Pets Table offer">
    {/* Ảnh chó (phải) — khung cắt 285×466, ảnh tràn ra ngoài như bản gốc */}
    <div class="ep-dog">
      {/* Giữ TỈ LỆ GỐC (786×1100 ≈ 2000×2800) để astro KHÔNG cắt; CSS thu về 393×549
          (scale nguyên ảnh như bản gốc), rồi lệch −48/−85 trong khung cắt 285×466 */}
      <Image src={dog} alt="The Pets Table dog" width={786} height={1100} />
    </div>
    {/* Logo "the Pets Table — BROUGHT TO YOU BY HelloFresh" (vector) */}
    <img class="ep-logo" src={logo.src} alt="The Pets Table — brought to you by HelloFresh" />
    {/* Ưu đãi 60% OFF 1st BOX + 20% OFF YOUR 2nd */}
    <img class="ep-discount" src={discount.src} alt="60% off 1st box + 20% off your 2nd" />

    <button class="ep-close" type="button" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <a class="ep-cta" href="#" data-close>Get Started</a>
    <button class="ep-notnow" type="button" data-close>Not Now, Thanks.</button>
  </div>
</div>

<style>
  @font-face {
    font-family: "Poppins";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/poppins-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "Poppins";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/fonts/poppins-500.woff2") format("woff2");
  }

  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .exit-popup[hidden] {
    display: none;
  }
  .exit-popup__backdrop {
    position: absolute;
    inset: 0;
    /* Bản gốc: nền mờ nhạt rgba(0,0,0,.15) */
    background: rgba(0, 0, 0, 0.15);
  }

  /* Hộp 700×500 CỐ ĐỊNH; thu nhỏ vừa màn hình nhỏ (không phóng to quá 1) */
  .exit-popup__box {
    position: relative;
    width: 700px;
    height: 500px;
    background: #bedbde;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.25);
    transform: scale(
      min(1, calc((100vw - 32px) / 700), calc((100vh - 32px) / 500))
    );
  }
  .exit-popup__box > * {
    position: absolute;
  }

  /* Ảnh chó: khung cắt 285×466 tại (377,36); ảnh tràn (393×549 tại −48,−85) */
  .ep-dog {
    left: 377px;
    top: 36px;
    width: 285px;
    height: 466px;
    overflow: hidden;
  }
  .ep-dog :global(img) {
    position: absolute;
    left: -48px;
    top: -85px;
    width: 393px;
    height: 549px;
    max-width: none;
    /* Bản gốc dùng object-fit: cover (ảnh 2000×2800 phủ khung 393×549) */
    object-fit: cover;
  }

  .ep-logo {
    left: 41px;
    top: 23px;
    width: 236px;
    height: 76px;
  }
  .ep-discount {
    left: 50px;
    top: 161px;
    width: 217px;
    height: auto;
  }

  .ep-close {
    top: 10px;
    right: 11px;
    width: 27px;
    height: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
  }

  /* Nút "Get Started" xanh (Poppins UA), bo 4px */
  .ep-cta {
    left: 50px;
    top: 406px;
    width: 217px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #86c345;
    border-radius: 4px;
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-size: 25px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }
  .ep-notnow {
    left: 62px;
    top: 469px;
    width: 193px;
    height: 18px;
    padding: 0;
    background: none;
    border: none;
    color: #333;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 400;
    text-align: center;
    cursor: pointer;
  }
</style>

<script>
  const popup = document.querySelector<HTMLElement>(".exit-popup");
  if (popup) {
    const COOKIE = "petsTablePopup";
    let shownThisPage = false;

    // Lưu bằng COOKIE PHIÊN (không đặt expires/max-age) → tự mất khi đóng trình duyệt.
    // Không còn khoá theo ngày: mỗi phiên hiện tối đa 1 lần.
    const seen = () =>
      document.cookie.split("; ").some((c) => c.startsWith(COOKIE + "="));
    const markSeen = () => {
      document.cookie = COOKIE + "=1; path=/; SameSite=Lax";
    };

    const show = () => {
      if (shownThisPage || popup.hidden === false || seen()) return;
      shownThisPage = true;
      popup.hidden = false;
      markSeen();
    };
    const close = () => {
      popup.hidden = true;
      markSeen();
    };

    // Trigger = exit-intent: chuột rời qua MÉP TRÊN cửa sổ
    document.addEventListener("mouseout", (e) => {
      if (e.clientY <= 0 && !e.relatedTarget) show();
    });
    popup.querySelectorAll("[data-close]").forEach((el) =>
      el.addEventListener("click", close)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.hidden) close();
    });
  }
</script>
