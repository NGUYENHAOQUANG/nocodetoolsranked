---
/* Một khối nội dung của bài review. Bản gốc chia bài thành nhiều
   `.paragraph_paragraph`, mỗi khối margin 10px 0 30px và tự là BFC nhờ
   `overflow-x: scroll` (để bảng rộng cuộn ngang được).

   Nội dung đưa vào qua <slot /> nên nằm NGOÀI phạm vi scoped CSS → mọi rule cho
   thẻ bên trong phải bọc :global(). */
---

<div class="paragraph">
  <div class="paragraph__content">
    <slot />
  </div>
</div>

<style>
  .paragraph {
    max-width: min(95dvw, 1060px);
    margin: 10px auto 30px;
    color: #2d2d2d;
    font-weight: 400;
    /* Tạo BFC + cho bảng rộng cuộn ngang; thanh cuộn ẩn đi */
    overflow-x: scroll;
    scrollbar-width: none;
  }
  .paragraph::-webkit-scrollbar {
    display: none;
  }
  .paragraph__content {
    max-width: min(95dvw, 1060px);
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7rem;
  }

  /* global.css reset margin h1–h6 + p về 0 → khai lại đúng mặc định UA của từng
     cấp (h1 .67em, h2 .83em, h3 1em, p 1em) vì bản gốc không reset. */
  .paragraph__content :global(h1) {
    margin: 0.67em 0;
    font-size: 2rem;
  }
  .paragraph__content :global(h2) {
    margin: 0.83em 0;
    font-size: 1.5625rem;
  }
  .paragraph__content :global(h3) {
    margin: 1em 0;
    font-size: 1.25rem;
  }
  .paragraph__content :global(h2),
  .paragraph__content :global(h3) {
    color: #2d2d2d;
    opacity: 1;
    line-height: 2.2rem;
  }
  .paragraph__content :global(p) {
    margin: 1em 0;
  }
  .paragraph__content :global(ul) {
    margin: 0;
    padding-left: 40px;
    list-style: circle;
  }
  .paragraph__content :global(ul li) {
    margin: 15px 0;
    line-height: 1.5rem;
  }
  /* Danh sách CÓ SỐ (ol) khác ul: số thập phân, li không có margin và line-height
     kế thừa 1.7rem (không phải 1.5rem như ul li). Margin khối 1em (mặc định ol) →
     16px desktop / 14px mobile; ĐỪNG hardcode 16px kẻo mobile dư 4px. */
  .paragraph__content :global(ol) {
    margin: 1em 0;
    padding-left: 40px;
    list-style: decimal;
  }

  /* Bảng giá: bản gốc dựng từ CMS nên viền nằm ở style inline của từng ô;
     ở đây chỉ giữ phần khung + kẻ sọc + hover. */
  .paragraph__content :global(table) {
    width: max-content;
    min-width: 100%;
    overflow: hidden;
    background-color: #fff;
    border-collapse: separate;
    border-spacing: 0;
  }
  .paragraph__content :global(table *) {
    overflow: hidden;
  }
  .paragraph__content :global(td) {
    padding: 7px;
    line-height: 1.5;
  }
  .paragraph__content :global(tbody tr) {
    background: transparent;
    transition: background 0.2s;
  }
  .paragraph__content :global(tbody tr:nth-child(2n)) {
    background: rgba(245, 245, 245, 0.1);
  }
  .paragraph__content :global(tbody tr:hover) {
    background: rgba(245, 245, 245, 0.02);
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .paragraph__content :global(table) {
      width: 100%;
    }
  }
</style>
