---
import visitorsIcon from "@/assets/icons/visitors-icon.svg";

interface Props {
  /** Đoạn đầu in đậm, vd "16,024 people" */
  highlight: string;
  text: string;
  /** Card đầu danh sách tự mở tooltip sau 1s thay vì chờ hover */
  shouldStayOpen?: boolean;
}

const { highlight, text, shouldStayOpen = false } = Astro.props;
---

<div class:list={["tooltip", { "tooltip--stay-open": shouldStayOpen }]}>
  <img
    class="tooltip__icon"
    src={visitorsIcon.src}
    width="35"
    height="35"
    alt="Tooltip Icon"
    loading="lazy"
  />
  <div class="tooltip__column">
    <p class="tooltip__text">
      <strong>{highlight}</strong><span>{text}</span>
    </p>
  </div>
</div>

<style>
  .tooltip {
    display: none;
    position: absolute;
    bottom: 105%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 0;
    /* Biến thể "nhiều nội dung" (icon + chữ) là dạng duy nhất trang gốc đang dùng */
    width: 200px;
    padding: 3px 5px;
    gap: 5px;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface);
    color: var(--color-text-body);
    border-radius: 5px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    text-align: center;
    white-space: normal;
    /* Bản gốc chỉ riêng tooltip này dùng Work Sans (không tự nạp — lấy font hệ thống) */
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.05rem;
  }

  /* Mũi nhọn trỏ xuống nút */
  .tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 45%;
    z-index: 0;
    border-width: 10px;
    border-style: solid;
    border-color: #fff transparent transparent;
    filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0.5));
  }

  @keyframes tooltip-fade-in {
    0% {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%);
    }
  }

  .tooltip__icon {
    object-fit: contain;
    flex-shrink: 0;
  }

  .tooltip__column {
    display: flex;
    flex-direction: column;
    flex: 1 1 0%;
  }

  .tooltip__text {
    margin: 0;
    flex: 1 1 0%;
    text-align: start;
    line-height: 1rem;
    font-weight: 400;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .tooltip__text strong {
    font-weight: 600;
  }

  /* Tooltip chỉ tồn tại từ 1025px — bản gốc không render nó ở dưới mốc này.
     Để hiện ở mọi kích thước thì nó rộng 200px sẽ tràn ngang trên mobile. */
  @media (min-width: 1025px) {
    .tooltip {
      bottom: 116%;
      z-index: 11;
    }
    .tooltip--stay-open {
      display: flex;
      opacity: 0;
      animation: tooltip-fade-in 0.3s linear 1s 1 normal forwards;
    }
    /* Biến thể không tự mở: bản gốc hiện tooltip này khi rê chuột vào nút
       "Visit Site" (không phải hover trực tiếp lên tooltip). `:global()` vì
       .partner__button thuộc component cha PartnerCard, ngoài phạm vi scope CSS
       của component này. */
    :global(.partner__button:hover) .tooltip:not(.tooltip--stay-open) {
      display: flex;
    }
  }
</style>
