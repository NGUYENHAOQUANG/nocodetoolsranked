---
// Contact cards + modal form (hover nâng thẻ, click mở modal)
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { STATIC_PAGES, EXTERNAL_REL } from "@/lib/links";

const { cards, modal } = (await getEntry("contact", "contact"))!.data;
---

<section class="contact">
  {
    /* Template cũ có một dòng chữ trang trí "hey" ở đây (h4.contactPage_page-subtitle).
      Trang mẫu hiện tại KHÔNG có nó — đã bỏ. Muốn thêm dòng dẫn nhập thì cho vào
      `blocks/contact.yaml` chứ đừng viết cứng lại vào component. */
  }
  <div class="contact__grid">
    {
      cards.map((card) => (
        <article
          class="contact-card"
          data-title={card.title}
          data-subtitle={card.subtitle}
          data-submit={card.button}
        >
          <div class="contact-card__content">
            <div class="contact-card__image">
              <Image src={card.image} alt={card.title} width={512} height={512} />
            </div>
            <h2 class="contact-card__title">{card.title}</h2>
            <p class="contact-card__subtitle">{card.subtitle}</p>
          </div>
          <button class="contact-card__button" type="button">
            {card.button}
          </button>
        </article>
      ))
    }
  </div>
</section>

{/* Modal dùng chung — điền tiêu đề/subtitle/nút theo card lúc mở (bản gốc portal ra body) */}
<div class="contact-modal" hidden>
  <div class="contact-modal__backdrop" data-close></div>
  <div
    class="contact-modal__box"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
  >
    <button class="contact-modal__close" type="button" data-close aria-label={modal.closeLabel}>
      <svg viewBox="0 0 512 512" width="23" height="23" aria-hidden="true">
        <path
          d="m289.94 256 95-95A24 24 0 0 0 351 127l-95 95-95-95a24 24 0 0 0-34 34l95 95-95 95a24 24 0 1 0 34 34l95-95 95 95a24 24 0 0 0 34-34z"
        ></path>
      </svg>
    </button>
    {
      /* Có chữ mặc định chứ không để rỗng: `aria-labelledby` trỏ vào đây, nên
      heading rỗng là hộp thoại không có tên. JS ghi đè bằng tiêu đề của thẻ
      được bấm ngay lúc mở. */
    }
    <h2 class="contact-modal__title" id="contact-modal-title">{modal.fallbackTitle}</h2>
    <p class="contact-modal__subtitle"></p>
    {
      /* Mỗi ô có <label> thật, ẩn bằng CSS chứ không thay bằng placeholder:
        placeholder biến mất ngay khi người dùng gõ, và nhiều trình đọc màn hình
        không đọc nó. Bản gốc không có nhãn nào — đây là sửa cho đúng chuẩn,
        không đổi một pixel nào vì nhãn nằm ngoài luồng. */
    }
    <form class="contact-modal__form">
      <div class="contact-modal__field">
        <label class="contact-modal__label" for="contact-name">{modal.fields.name}</label>
        <input id="contact-name" name="name" type="text" placeholder={modal.fields.name} />
      </div>
      <div class="contact-modal__field">
        <label class="contact-modal__label" for="contact-company">{modal.fields.company}</label>
        <input id="contact-company" name="company" type="text" placeholder={modal.fields.company} />
      </div>
      <div class="contact-modal__field">
        <label class="contact-modal__label" for="contact-email">{modal.fields.email}</label>
        <input id="contact-email" name="email" type="email" placeholder={modal.fields.email} />
      </div>
      <div class="contact-modal__field">
        <label class="contact-modal__label" for="contact-message">{modal.fields.message}</label>
        <textarea id="contact-message" name="message" placeholder={modal.fields.message}></textarea>
      </div>
      <button class="contact-modal__submit" type="submit"></button>
    </form>
    {
      /* Đoạn NÀY ở lại component, khác mọi chữ khác trong file. Nó không phải một
        chuỗi mà là một câu đan bằng ba link, và cả ba href đều là chuyện của code:
        một dựng từ `STATIC_PAGES`, hai cái kia là URL Google bắt buộc kèm
        `EXTERNAL_REL`. Đưa vào YAML thì phải cắt thành `phan1`/`phan2`/`phan3` —
        đó mới là thủ thuật, không phải cách sửa. Chữ nghĩa cũng không ai A/B test:
        Google quy định đúng câu này khi dùng reCAPTCHA.

        Bản gốc lặp "Privacy Policy" hai lần liền ("agree to our Privacy Policy
        Privacy Policy.") — lỗi chép, đã bỏ chữ thừa. */
    }
    <p class="contact-modal__disclaimer">
      by clicking the button you agree to our <a
        class="contact-modal__link-bold"
        href={STATIC_PAGES.privacy}>Privacy Policy.</a
      > This site is protected by reCAPTCHA and the Google <a
        href="https://policies.google.com/privacy"
        target="_blank"
        rel={EXTERNAL_REL}>Privacy Policy</a
      > and <a href="https://policies.google.com/terms" target="_blank" rel={EXTERNAL_REL}
        >Terms of Service</a
      > apply.
    </p>
  </div>
</div>

<style>
  /* Section bọc: min-height 60vh (bản gốc contactPage_no-title), căn giữa dọc+ngang.
     Trang ngắn → footer bị đẩy xuống bởi min-height. */
  .contact {
    min-height: 60dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  /* Lưới thẻ: base (mobile) 1 cột đầy; ≥768 auto-fit 245px căn giữa (ô rỗng co về 0) */
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 20px;
    padding: 10px 0 20px;
    width: 100%;
  }

  /* Thẻ: rộng 300 nhưng tối đa 90% cột (desktop 245→220.5; mobile full→300).
     Cao CỐ ĐỊNH (mobile 300, desktop 320) → nút luôn ở đáy. */
  .contact-card {
    width: 300px;
    max-width: 90%;
    height: 300px;
    display: flex;
    flex-direction: column;
    /* Khe 2px giữa nội dung và nút (bản gốc: content-container 271.1 + 2 + nút 46.9
       = 320) → subtitle (margin-top:auto) không bị đẩy thấp thêm 2px */
    gap: 2px;
    box-shadow: 0 1px 7px 3px rgb(177, 176, 176);
    /* Cả thẻ bấm được → mở modal; hover nâng lên 5px (bản gốc: translate 0 -5px) */
    cursor: pointer;
    transition: 0.3s linear;
  }
  .contact-card:hover {
    translate: 0 -5px;
  }
  .contact-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .contact-card__image {
    height: 140px;
    padding-top: 3px;
    flex-shrink: 0;
  }
  .contact-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .contact-card__title {
    margin: 1em 0;
    color: var(--color-text-body);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.7rem;
  }
  /* margin-top:auto → hút hết khoảng trống, đẩy subtitle xuống sát nút (giống bản gốc,
     nên khe title↔subtitle giãn theo chiều cao thừa của thẻ) */
  .contact-card__subtitle {
    margin: auto 0 1em;
    padding: 0 5px;
    color: var(--color-text-body);
    font-size: 1rem;
    line-height: 1.2rem;
  }
  .contact-card__button {
    /* Bản gốc KHÔNG reset <button> → chữ dùng font UA (Arial), KHÔNG phải Lato.
       global.css có `button{font:inherit}` nên phải `font:revert` để lấy lại font UA,
       rồi khai lại cỡ/đậm. Nút native tự căn giữa chữ theo chiều dọc. */
    font: revert;
    /* Chiều cao nút CỐ ĐỊNH theo bản gốc, đổi ở mốc 768 cùng chiều cao thẻ:
       46.44px (<768, thẻ 300) / 46.9px (≥768, thẻ 320). box-sizing border-box. */
    box-sizing: border-box;
    height: 46.44px;
    padding: 1px 6px;
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    border: none;
    cursor: pointer;
  }

  /* ≥768px: thẻ cao 320, subtitle nhỏ 0.8125rem, lưới auto-fit 245 căn giữa */
  @media (min-width: 768px) {
    .contact__grid {
      grid-template-columns: repeat(auto-fit, 245px);
      justify-content: center;
    }
    .contact-card {
      height: 320px;
    }
    .contact-card__subtitle {
      font-size: 0.8125rem;
    }
    .contact-card__button {
      height: 46.9px;
    }
  }

  /* ===================== MODAL FORM ===================== */
  /* Bản gốc portal modal ra body → thoát scope Lato: chữ dùng system-ui, ô input +
     nút dùng font UA (Arial). Nền tối rgba(0,0,0,.5), hộp trắng 375, bo 3px. */
  .contact-modal {
    position: fixed;
    top: 0;
    left: 0;
    /* 100dvw/100dvh (kể cả vùng thanh cuộn) để căn giữa theo TRỌN viewport như bản
       gốc — dùng inset:0 sẽ căn theo clientWidth (đã trừ thanh cuộn) → lệch ~8px */
    width: 100dvw;
    height: 100dvh;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-modal[hidden] {
    display: none;
  }
  .contact-modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
  }
  .contact-modal__box {
    position: relative;
    box-sizing: border-box;
    width: 375px;
    max-width: 90dvw;
    max-height: 95dvh;
    overflow-y: auto;
    padding: 7px 12px;
    background: var(--color-surface);
    border-radius: 3px;
    box-shadow: 0 0 12px 1px #454545;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Helvetica Neue",
      Arial,
      "Noto Sans",
      sans-serif;
    text-align: left;
  }
  .contact-modal__close {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 23px;
    height: 23px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }
  .contact-modal__close svg {
    display: block;
    width: 23px;
    height: 23px;
    fill: var(--color-text-body);
  }
  .contact-modal__title {
    margin: 5px 0;
    color: var(--color-text-body);
    font-size: 1.4rem;
    font-weight: 700;
  }
  .contact-modal__subtitle {
    margin: 0;
    color: var(--color-text-body);
    font-size: 0.8125rem;
    line-height: 1.7rem;
  }
  .contact-modal__form {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  /* Nhãn ẩn khỏi MẮT nhưng vẫn ở trong cây trợ năng — thiết kế không có chỗ cho
     chữ nhãn, nhưng bỏ nhãn thì trình đọc màn hình không biết ô nào là ô nào.
     Dùng clip-path chứ không `display: none` hay `visibility: hidden`: hai cái
     đó gỡ phần tử khỏi cây trợ năng luôn, tức là mất đúng thứ cần giữ. */
  .contact-modal__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Ô input/textarea: font UA (Arial) — KHÔNG set family để giữ mặc định như bản gốc */
  .contact-modal__form input,
  .contact-modal__form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 2px solid #bbb;
    border-radius: 5px;
    font-size: 1rem;
  }
  .contact-modal__form input {
    height: 50px;
    padding: 0 8px;
  }
  .contact-modal__form textarea {
    height: 210px;
    padding: 8px;
    resize: none;
  }
  .contact-modal__submit {
    /* Nút submit: font UA Arial (font:revert), căn giữa, cao 45px */
    align-self: center;
    font: revert;
    font-weight: 600;
    height: 45px;
    padding: 2px 6px;
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    border: none;
    border-radius: 5px;
    cursor: pointer;
  }
  .contact-modal__disclaimer {
    margin: 0;
    color: var(--color-text-body);
    font-size: 0.7rem;
    line-height: 1.7rem;
    text-align: left;
  }
  .contact-modal__disclaimer a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .contact-modal__disclaimer a.contact-modal__link-bold {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
  }
</style>

<script>
  const modal = document.querySelector<HTMLElement>(".contact-modal");
  if (modal) {
    const titleEl = modal.querySelector<HTMLElement>(".contact-modal__title");
    const subEl = modal.querySelector<HTMLElement>(".contact-modal__subtitle");
    const submitEl = modal.querySelector<HTMLElement>(".contact-modal__submit");

    const open = (card: HTMLElement) => {
      if (titleEl) titleEl.textContent = card.dataset.title ?? "";
      if (subEl) subEl.textContent = card.dataset.subtitle ?? "";
      if (submitEl) submitEl.textContent = card.dataset.submit ?? "";
      modal.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = "";
    };

    document.querySelectorAll<HTMLElement>(".contact-card").forEach((card) => {
      card.addEventListener("click", () => open(card));
    });
    modal.querySelectorAll("[data-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    // Không cho form thật sự gửi (bản clone tĩnh)
    modal.querySelector("form")?.addEventListener("submit", (e) => e.preventDefault());
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) close();
    });
  }
</script>
