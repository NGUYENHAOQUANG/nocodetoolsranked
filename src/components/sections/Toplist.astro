---
import { getHomepageBrands } from "@/lib/rankings";

const brands = await getHomepageBrands();
import PartnerCard from "@/components/brand/PartnerCard.astro";
import PromoBanner from "@/components/sections/PromoBanner.astro";
import thePetsTable from "@/assets/brands/the-pets-table.svg";

/** Banner khuyến mãi chèn xen giữa danh sách, ngay sau card hạng này */
const PROMO_AFTER_RANK = 2;

const promo = {
  logo: thePetsTable,
  logoAlt: "The Pet's Table - ",
  title: " 100% Money-Back Guarantee",
  buttonText: "Get Started",
  href: "#",
};
---

<section class="toplist">
  <div class="toplist__list">
    {
      brands.map((brand, i) => (
        <>
          <PartnerCard brand={brand} sideBanner={i === 0} />
          {brand.rank === PROMO_AFTER_RANK && <PromoBanner {...promo} />}
        </>
      ))
    }
  </div>
</section>

<style>
  .toplist {
    position: relative;
    z-index: 20;
    min-height: 30dvh;
  }

  /* Bản gốc có rule chung cho mọi section trong trang: từ 1025px thêm 30px đáy,
     tạo khoảng cách tới section "Best Overall" phía dưới. (margin-top 2px không có
     tác dụng vì bị margin 5px của card đầu nuốt khi collapse.) */
  @media (min-width: 1025px) {
    .toplist {
      margin: 2px auto 30px;
    }
  }

  .toplist__list {
    width: 100%;
    max-width: min(1060px, 95dvw);
    margin-inline: auto;
  }
</style>
