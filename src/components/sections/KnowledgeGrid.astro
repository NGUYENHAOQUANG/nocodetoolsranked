---
import { Image } from "astro:assets";
import { knowledgeCards } from "@/data/knowledge";

/** Mũi tên ">" ở "Read More" — path lấy nguyên từ bản gốc (viewBox 1024) */
const ARROW =
  "M869 487.8L491.2 159.9c-2.9-2.5-6.6-3.9-10.5-3.9h-88.5c-7.4 0-10.8 9.2-5.2 14l350.2 304H152c-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8h585.1L386.9 854c-5.6 4.9-2.2 14 5.2 14h91.5c1.9 0 3.8-.7 5.2-2L869 536.2a32.07 32.07 0 0 0 0-48.4z";
---

<div class="knowledge-grid">
  {
    knowledgeCards.map((card) => (
      <article class="k-card">
        <a class="k-card__image" href={card.href} aria-label={card.title}>
          {/* Giữ NGUYÊN tỉ lệ ảnh gốc (không ép 350×239 kẻo méo) — để CSS object-fit
              cover cắt giữa lúc hiển thị, y hệt bản gốc */}
          <Image src={card.image} alt={card.imageAlt} width={card.image.width} height={card.image.height} />
          <span class="k-card__overlay" aria-hidden="true" />
        </a>
        <div class="k-card__content">
          <div class="k-card__meta">
            <span>{card.date}</span> {card.readTime}
          </div>
          <a class="k-card__title-link" href={card.href}>
            <h5 class="k-card__title">{card.title}</h5>
          </a>
          <p class="k-card__excerpt">{card.excerpt}</p>
          <a class="k-card__more" href={card.href}>
            Read More
            <svg viewBox="0 0 1024 1024" width="1em" height="1em" fill="currentColor" aria-hidden="true">
              <path d={ARROW} />
            </svg>
          </a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .knowledge-grid {
    /* <1025px: max-width 1060, KHÔNG margin trên/dưới; ≥1025 lên 1200 + margin */
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 10px;
    display: grid;
    grid-template-columns: 1fr; /* base: 1 cột */
    gap: 20px;
    justify-items: center;
  }

  .k-card {
    /* Bản gốc: mỗi thẻ có margin 10px → hàng đầu lùi 10px, khe hàng hiệu dụng
       = 10 + gap 20 + 10 = 40px */
    width: 100%;
    max-width: 350px;
    margin: 10px 0;
    display: flex;
    flex-direction: column;
  }

  /* ----- Ảnh + lớp phủ cam khi hover ----- */
  .k-card__image {
    position: relative;
    display: block;
    width: 100%;
    height: 239px;
    overflow: hidden;
  }
  .k-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .k-card__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    opacity: 0;
    transition: opacity 0.2s linear;
  }
  /* Khung viền trắng zoom vào khi hover (bản gốc: overlay::after) */
  .k-card__overlay::after {
    content: "";
    position: absolute;
    top: 4%;
    left: 4%;
    width: 90%;
    height: 90%;
    border: 3px solid #fff;
    opacity: 0;
    transform: scale(0.7);
    transition: 0.5s linear;
  }
  .k-card:hover .k-card__overlay {
    opacity: 0.4;
  }
  .k-card:hover .k-card__overlay::after {
    opacity: 1;
    transform: scale(1);
  }

  /* ----- Nội dung: hộp có bóng đổ, chữ ----- */
  .k-card__content {
    /* Cao CỐ ĐỊNH → mọi thẻ bằng nhau, "Read More" đẩy xuống đáy.
       <1025px = 250px; ≥1025px = 300px (xem media query) */
    height: 250px;
    display: flex;
    flex-direction: column;
    padding: 20px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
  }
  .k-card__meta {
    /* Bản gốc: opacity 0.7 → chữ nhạt hơn; đồng thời tạo layer riêng nên chữ
       khử răng cưa GRAYSCALE (không subpixel như tiêu đề) — khớp y hệt. */
    opacity: 0.7;
    color: #2d2d2d;
    font-size: 0.9rem;
    line-height: 1.7rem;
  }
  /* Dấu "|" ngăn ngày với thời lượng đọc = viền phải mảnh xám của ô ngày */
  .k-card__meta span {
    padding-right: 5px;
    border-right: 1px solid #dadada;
  }
  .k-card__title-link {
    color: inherit;
  }
  .k-card__title {
    margin: 5px 0;
    color: #000;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.7rem;
  }
  .k-card__excerpt {
    margin: 0;
    color: #2d2d2d;
    font-size: 1rem;
    line-height: 1.7rem;
  }
  .k-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    width: max-content;
    color: #000;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.7rem;
  }
  .k-card__more svg {
    position: relative;
    top: 1px;
  }
  /* Bản gốc: hover tiêu đề = GẠCH CHÂN (không đổi màu); "Read More" không có hover */
  .k-card__title:hover {
    text-decoration: underline;
    cursor: pointer;
  }

  /* ===== ≥768px: 2 cột ===== */
  @media (min-width: 768px) {
    .knowledge-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* ===== ≥1025px: 3 cột + hộp cao 300, lưới rộng 1200 ===== */
  @media (min-width: 1025px) {
    .knowledge-grid {
      grid-template-columns: repeat(3, 1fr);
      max-width: 1200px;
      margin: 2px auto 30px;
    }
    .k-card__content {
      height: 300px;
    }
  }
</style>
