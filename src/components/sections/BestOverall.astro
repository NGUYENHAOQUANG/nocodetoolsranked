---
import { getHomepageBrands } from "@/lib/rankings";

const brands = await getHomepageBrands();
import PartnerCard from "@/components/brand/PartnerCard.astro";

/** Bản gốc lặp lại đúng card hạng 1 (The Pet's Table) ở cuối trang */
const brand = brands[0];
---

<section class="best-overall">
  <div class="best-overall__inner">
    <h3 class="best-overall__title">Best Overall Dog Food Delivery</h3>
    <PartnerCard brand={brand} showRank={false} bestOverall />
  </div>
</section>

<style>
  .best-overall {
    width: 100%;
    margin: 0 auto 30px;
    padding-bottom: 17px;
    border-top: 1px solid #cbcbcb;
    border-bottom: 1px solid #cbcbcb;
  }

  .best-overall__inner {
    width: 100%;
    max-width: min(1060px, 95dvw);
    margin-inline: auto;
  }

  .best-overall__title {
    width: 100%;
    margin: 20px 0 0;
    padding: 5px;
    font-size: 1.4rem;
    font-weight: 700;
    text-align: start;
    color: #2d2d2d;
  }
</style>
