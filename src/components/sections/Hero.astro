---
import { Image } from "astro:assets";
import heroImgDesktop from "@/assets/images/hero.jpg";
import heroImgMobile from "@/assets/images/hero-mobile.jpg";

interface Props {
  /** Trang trong (vd /reviews/): chỉ hiện tiêu đề và căn giữa theo chiều dọc —
      bỏ subtitle, "Last Updated" và tooltip "Advertising Disclosure" */
  inner?: boolean;
  /** Chỉ dùng cho biến thể `inner` — tiêu đề bản DESKTOP */
  title?: string;
  /** Tiêu đề bản MOBILE (<768px). Bản gốc để chuỗi KHÁC hẳn desktop; không
      truyền thì dùng lại `title`. */
  mobileTitle?: string;
  /** Biến thể `inner`: căn tiêu đề LÊN ĐẦU banner thay vì giữa (trang /about-page/
      dùng space-between/flex-start, khác /reviews/ và /knowledge/ căn giữa). */
  titleTop?: boolean;
  alt?: string;
  mobileAlt?: string;
}

const {
  inner = false,
  title = "",
  mobileTitle = title,
  titleTop = false,
  alt = "Best Dog Food Delivery Brands 2026 — Fresh Dog Food Delivery",
  mobileAlt = alt,
} = Astro.props;

const innerContentClass = [
  "hero__content",
  "hero__content--inner",
  titleTop && "hero__content--top",
]
  .filter(Boolean)
  .join(" ");

// Trang gốc tự hiển thị ngày = hôm nay; lấy ngày lúc build cho khớp hành vi đó.
const lastUpdated = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date());
---

<section class="hero">
  {
    inner ? (
      <>
        {/* Bản gốc dựng banner mobile/desktop thành HAI cây riêng: JS chọn cây theo
            `clientWidth` (mốc 768), còn CSS lại ẩn theo `innerWidth` — lệch nhau đúng
            15px thanh cuộn nên ở 768–782px KHÔNG cây nào hiện, chừa 170px trắng.
            Tái hiện y hệt bằng 2 mốc ẩn lệch nhau ở cuối file. */}
        <div class="hero__banner hero__banner--mobile-only">
          <Image class="hero__bg" src={heroImgMobile} alt={mobileAlt} sizes="100vw" loading="eager" />
          <div class={innerContentClass}>
            <div class="hero__text">
              {/* set:html để tiêu đề mobile chèn <br> cứng như bản gốc (vd
                  "Top Dog Food Delivery" xuống dòng rồi "Reviews") — không tự wrap */}
              <h1 class="hero__title" set:html={mobileTitle} />
            </div>
          </div>
        </div>
        <div class="hero__banner hero__banner--desktop-only">
          <Image class="hero__bg" src={heroImgDesktop} alt={alt} sizes="100vw" loading="eager" />
          <div class={innerContentClass}>
            <div class="hero__text">
              <h1 class="hero__title" set:html={title} />
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class="hero__banner">
  <Image
    class="hero__bg hero__bg--desktop"
    src={heroImgDesktop}
    alt={alt}
    sizes="100vw"
    loading="eager"
  />
  <Image
    class="hero__bg hero__bg--mobile"
    src={heroImgMobile}
    alt={alt}
    sizes="100vw"
    loading="eager"
  />
  <div class="hero__content">
    <div class="hero__text">
      <h1 class="hero__title">
        Best Dog Food Delivery <span class="hero__title-word">Brands </span>2026
      </h1>
      <p class="hero__subtitle hero__subtitle--wide">
        The best for your best friend! Discover top dog food subscriptions for
        fresh, nutritious meals delivered to your door. Compare and choose today!
      </p>
      {/* Bản gốc xuống dòng bằng <br> cứng, dòng 2 có dấu cách đầu — không phải tự wrap */}
      <p class="hero__subtitle hero__subtitle--compact">
        <span>Compare Top Dog Food Delivery</span><br /><span>
          Services for Healthier, Happier Pets.</span
        >
      </p>
    </div>

    {/* KHÔNG để khoảng trắng giữa </svg> và <span>: đây là dòng inline, khoảng trắng sẽ thành dấu cách thừa */}
    <p class="hero__updated">
      <svg viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path
          d="M504 256c0 136.967-111.033 248-248 248S8 392.967 8 256 119.033 8 256 8s248 111.033 248 248zM227.314 387.314l184-184c6.248-6.248 6.248-16.379 0-22.627l-22.627-22.627c-6.248-6.249-16.379-6.249-22.628 0L216 308.118l-70.059-70.059c-6.248-6.248-16.379-6.248-22.628 0l-22.627 22.627c-6.248 6.248-6.248 16.379 0 22.627l104 104c6.249 6.249 16.379 6.249 22.628.001z"
        ></path></svg><span class="hero__updated-text"
        >Last Updated: <span>{lastUpdated}</span></span
      >
    </p>
  </div>

  <div class="hero__disclosure">
    <span class="hero__disclosure-label">Advertising Disclosure</span>
    <span class="hero__disclosure-tooltip" role="tooltip">
      top10dogfood.com is an independent review and comparison website funded by
      referral fees. We may be paid compensation when a user purchases a dog food
      subscription through our website links. This does not affect our reviews and
      ratings which are based on thousands of ratings and testing our team made. We
      regularly review new dog food delivery services but do not feature every dog
      food product on the market due to high amount of companies.
    </span>
  </div>
      </div>
    )
  }
</section>

<style>
  /* ===== Base = mobile (< 615px) ===== */
  /* Ô chừa chỗ cho banner: chỉ min-height 170px. Chiều cao THẬT (172px) do banner
     bên trong quyết định — nhờ vậy lúc không banner nào hiện (768–782px) vẫn còn
     đúng 170px trắng như bản gốc. */
  .hero {
    position: relative;
    min-height: 170px;
    background: #eaf4fb;
  }
  .hero__banner {
    position: relative;
    min-height: 172px;
    display: grid;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
    z-index: 0;
  }
  .hero__bg--desktop {
    display: none;
  }
  /* Ảnh mobile căn giữa theo chiều dọc (ảnh desktop thì căn mép trên) — đúng bản gốc */
  .hero__bg--mobile {
    object-position: right center;
  }

  /* Bản gốc dùng margin 12px 0 (không phải padding) và để grid kéo giãn ô này */
  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(1060px, 95dvw);
    margin: 12px auto;
    display: flex;
    flex-direction: column;
  }

  /* Bản gốc chỉ đổi justify-content: trang chủ đẩy "Last Updated" xuống đáy
     (space-between), trang trong căn giữa tiêu đề. Padding đối xứng nên tâm
     tiêu đề rơi đúng giữa banner. */
  .hero__content--inner {
    justify-content: center;
  }
  /* /about-page/: tiêu đề căn LÊN ĐẦU (bản gốc dùng space-between/flex-start,
     một con nên nằm sát trên) — đè lên căn-giữa của --inner */
  .hero__content--top {
    justify-content: flex-start;
  }

  /* flex column để margin title/subtitle KHÔNG collapse */
  .hero__text {
    display: flex;
    flex-direction: column;
  }

  .hero__title {
    margin: 5px 0;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2px;
    color: var(--color-text);
  }
  /* "Brands" chỉ hiện từ 615px trở lên */
  .hero__title-word {
    display: none;
  }

  .hero__subtitle {
    margin: 5px 0;
    /* Chừa lề phải để chữ không đè lên ảnh con chó — bản gốc áp ở MỌI kích thước */
    padding-right: min(30%, 200px);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.5rem;
    color: var(--color-text);
  }
  .hero__subtitle--wide {
    display: none;
  }

  /* Dòng inline như gốc: icon nằm trên baseline của chữ (không phải flex căn giữa),
     nhờ vậy icon cao đúng vị trí. line-height kế thừa 1.7em từ body. */
  .hero__updated {
    margin-top: auto;
    display: block;
    width: fit-content;
    font-size: 1rem;
    color: #000;
  }
  .hero__updated svg {
    position: relative;
    top: 1px;
  }
  .hero__updated-text {
    margin-left: 5px;
  }

  /* Advertising Disclosure: chỉ desktop (≥1025px) */
  .hero__disclosure {
    display: none;
    position: absolute;
    left: 80%;
    bottom: 10px;
    z-index: 11;
    font-size: 1rem;
    line-height: 1.7;
    color: #2d2d2d;
    cursor: pointer;
  }
  /* Khi mở phải vượt lên trên toplist (z-index 20) — nếu không, side banner của
     card #1 sẽ đè lên tooltip. Bản gốc cũng nâng lên 1000 lúc mở (bằng JS). */
  .hero__disclosure.is-open {
    z-index: 1000;
  }
  .hero__disclosure-tooltip {
    position: absolute;
    top: 100%;
    right: -16px;
    width: 320px;
    padding: 10px;
    background: #fff;
    color: #000;
    font-size: 0.8125rem;
    line-height: 1.2rem;
    border-radius: 5px;
    box-shadow: 0 0 7px 0 #4a4a4a;
    max-height: 90dvh;
    overflow: auto;
    z-index: 30;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease;
  }
  .hero__disclosure.is-open .hero__disclosure-tooltip {
    opacity: 1;
    visibility: visible;
  }

  /* ===== Từ 768px: đổi sang ảnh + nội dung bản desktop (KHÔNG phải 615px) ===== */
  @media (min-width: 768px) {
    /* Bản gốc: banner MOBILE để tiêu đề chạy full chiều ngang (max-width none);
       chỉ banner DESKTOP mới giới hạn 95% để tiêu đề dài (bài blog) ngắt 2 dòng.
       Vì vậy chỉ áp max-width từ 768px trở lên (nơi banner desktop hiện). */
    .hero__title {
      max-width: 95%;
    }
    .hero__bg--desktop {
      display: block;
    }
    .hero__bg--mobile {
      display: none;
    }
    .hero__title-word {
      display: inline;
    }
    .hero__subtitle--wide {
      display: block;
    }
    .hero__subtitle--compact {
      display: none;
    }
  }

  /* Hai mốc ẩn LỆCH NHAU 15px (đúng bằng thanh cuộn) — xem chú thích ở markup.
     Kết quả: <768 hiện bản mobile, ≥783 hiện bản desktop, 768–782 trắng. */
  @media (min-width: 768px) {
    .hero__banner--mobile-only {
      display: none;
    }
  }
  @media (max-width: 782px) {
    .hero__banner--desktop-only {
      display: none;
    }
  }

  /* ===== Desktop (≥ 1025px): kích thước đầy đủ ===== */
  @media (min-width: 1025px) {
    .hero {
      min-height: 220px;
    }
    .hero__banner {
      min-height: 220px;
    }
    .hero__content {
      margin-block: 22px;
    }
    .hero__title {
      font-size: 2.35rem;
    }
    .hero__subtitle {
      line-height: 1.6rem;
    }
    .hero__disclosure {
      display: block;
    }
  }
</style>

<script>
  // Giống trang gốc: hover hiện tooltip, click vào nhãn thì đảo trạng thái (ẩn/hiện)
  const el = document.querySelector<HTMLElement>(".hero__disclosure");
  const label = el?.querySelector<HTMLElement>(".hero__disclosure-label");
  if (el && label) {
    el.addEventListener("mouseenter", () => el.classList.add("is-open"));
    el.addEventListener("mouseleave", () => el.classList.remove("is-open"));
    label.addEventListener("click", () => el.classList.toggle("is-open"));
  }
</script>
