---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroInner from "@/components/sections/HeroInner.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ContactCards from "@/components/sections/ContactCards.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
---

<BaseLayout title="Top 10 Dog Food Subscriptions - Contact Us">
  <Header />
  <HeroInner
    title="Contact Us"
    mobileTitle="Contact Us"
    alt="Contact Us | Fresh Dog Food Delivery"
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: "Contact Us" }]} />
  <main>
    <ContactCards />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
