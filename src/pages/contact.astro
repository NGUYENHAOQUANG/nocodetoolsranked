---
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import ContactCards from "@/components/contact/ContactCards.astro";

/* Nhãn banner + mốc breadcrumb là "Contact"; thẻ <title> mới là "Contact Us" */
const TITLE = "Contact";
---

<InnerPageLayout
  title="Contact Us - NoCodeToolsRanked"
  description="Contact us for more queries and questions about the best website builders of 2026. Choose the best service providers today!"
  heroTitle={TITLE}
  crumbs={[{ text: "Home" }, { text: TITLE }]}
>
  <main id="main-content">
    <ContactCards />
  </main>
</InnerPageLayout>
