---
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import ContactCards from "@/components/contact/ContactCards.astro";

const TITLE = "Contact Us";
---

<InnerPageLayout
  title={`Top 10 Dog Food Subscriptions - ${TITLE}`}
  description="Get in touch with top10dogfood.com - partnership enquiries, feedback on our reviews, or help choosing a dog food subscription."
  heroTitle={TITLE}
  crumbs={[{ text: "Home" }, { text: TITLE }]}
>
  <main id="main-content">
    <ContactCards />
  </main>
</InnerPageLayout>
