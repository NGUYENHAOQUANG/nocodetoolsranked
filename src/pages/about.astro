---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroInner from "@/components/sections/HeroInner.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
---

<BaseLayout title="Top Dog Food Subscriptions - About Us">
  <Header />
  <HeroInner
    isTitleTop
    title="About"
    mobileTitle="About"
    alt="About | Fresh Dog Food Delivery"
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: "About" }]} />
  <main>
    <article class="about">
      <h4>Our Mission</h4>
      <p>
        We greatly value our readers, thus provided them with all the
        information they might need to make an informed decision
      </p>

      <h4>How We Do it?</h4>
      <p>
        How do we assist people just like you in making an educated choice
        between an array of well-ranked websites, platforms, service providers,
        and applications?
      </p>
      <p>
        We utilize an extremely talented team of expert researchers and
        consultants that know the industry inside and out, in turn providing you
        with a service that will exceed your expectations.
      </p>
      <p>
        Our expert unit acts carefully and cautiously to produce easy-to-read
        directories on topics that are difficult to understand.
      </p>
      <p>This is exactly why we are here.</p>
      <p>
        Heaps of users utilize our website when searching for prime online
        services, rather than filtering through immeasurable loads of search
        results and infinite material. Our site not only aims at being
        time-efficient but we also aim to provide the best offers. We aim to
        provide our users with the latest and best in all fields thus, our team
        is constantly providing new data and statistics in order to display any
        modifications in the market. Keeping users updated at all times.
      </p>
      <p>
        Our site is accessible and user-friendly, especially with our advanced
        ranking system which enables you to compare services and pick the best
        one for you in just a few minutes.
      </p>

      <h4>To use the site simply follow these steps</h4>
      <p>
        -Select the specific service you are searching for<br />
        -Compare the best products and assess their previous reviews<br />
        -Simply pick the service that is best suited to your needs
      </p>
      <p>&nbsp;</p>

      <h4>Contact Us</h4>
      <p>
        We would love to hear from you with regards to feedback, inquiries,
        experiences, or questions.
      </p>
    </article>
  </main>
  <Footer />
  <ToTop />
</BaseLayout>

<style>
  /* Cùng khung nội dung prose như bản gốc (paragraph_content): rộng tối đa 1060,
     căn giữa; trên 2px, dưới 30px như các trang trong khác */
  .about {
    /* Bản gốc: rộng 95% (căn giữa), tối đa 1060 → mobile 95% viewport, desktop khoá 1060 */
    width: 95%;
    max-width: 1060px;
    /* <1025: breadcrumb ẩn → nội dung sát ngay hero (margin trên 0); khoảng cách tới
       footer = đúng margin đáy của <p> cuối (14px) nên margin dưới cũng 0 */
    margin: 0 auto;
    color: #2d2d2d;
    font-size: 1rem;
    line-height: 1.7rem;
  }
  .about h4 {
    margin: 1.33em 0;
    color: #2d2d2d;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 2.1rem;
  }
  .about h4:first-of-type {
    margin-top: 0;
  }
  .about p {
    margin: 1em 0;
  }

  /* ≥1025px: breadcrumb hiện → cách nó 2px trên; dưới thêm 30px tới footer
     (bản gốc: 16 chứa margin <p> cuối + 30). 46 > 16 nên collapse ra đúng 46px. */
  @media (min-width: 1025px) {
    .about {
      margin: 2px auto 46px;
    }
  }
</style>
