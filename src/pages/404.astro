---
/* Trang 404. @astrojs/sitemap tự loại "404" và "500" khỏi sitemap nên không cần
   khai `filter` trong astro.config. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import { HOME, REVIEWS_INDEX, KNOWLEDGE_INDEX } from "@/lib/links";

const TITLE = "Page Not Found";
---

<BaseLayout title={`Top 10 Dog Food Subscriptions - ${TITLE}`}>
  <Header />
  {/* Không có breadcrumb: trang này không nằm ở vị trí nào trong cây điều hướng */}
  <Hero isInner isTitleTop title={TITLE} mobileTitle={TITLE} alt={`${TITLE} | Fresh Dog Food Delivery`} />
  <main>
    <section class="not-found">
      <p>The page you were looking for does not exist or has been moved.</p>
      <ul class="not-found__links">
        <li><a href={HOME}>Go to the homepage</a></li>
        <li><a href={REVIEWS_INDEX}>Browse dog food reviews</a></li>
        <li><a href={KNOWLEDGE_INDEX}>Read the knowledge center</a></li>
      </ul>
    </section>
  </main>
  <Footer />
  <ToTop />
</BaseLayout>

<style>
  /* Cùng khung với các trang nội dung phẳng khác (95% / 1060px / căn giữa).
     `min-height` để footer không trôi lên giữa màn hình ở trang ngắn. */
  .not-found {
    display: flow-root;
    width: 95%;
    max-width: 1060px;
    min-height: 70dvh;
    margin: 0 auto;
    color: #2d2d2d;
    font-size: 1rem;
    line-height: 1.7rem;
  }

  .not-found p {
    margin: 1em 0;
  }

  .not-found__links {
    margin: 1em 0;
    padding-left: 40px;
    list-style: circle;
  }

  .not-found__links a:hover {
    color: var(--color-primary);
  }

  @media (min-width: 1025px) {
    .not-found {
      margin: 2px auto 30px;
    }
  }
</style>
