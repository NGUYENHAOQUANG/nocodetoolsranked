---
/**
 * Mỗi file trong `content/toplists/` -> một trang toplist ở GỐC site.
 *
 * Entry `home` cho ra param `undefined`, tức URL "/" — nhờ vậy trang chủ và mọi
 * ngách dùng CHUNG một khuôn, không có `index.astro` chép lại thân trang.
 *
 * Route rest nên nó xếp hạng THẤP hơn `[page].astro` (3 trang nội dung phẳng) và
 * các page tĩnh — đã kiểm bằng build: /contact/, /reviews/, /knowledge/
 * không bị nuốt. Ràng buộc kèm theo: id trong `toplists/` không được trùng id
 * trong `pages/`, cũng không được là `contact`, `reviews`, `knowledge`.
 */
import { getCollection, getEntry } from "astro:content";
import { organizationSchema, websiteSchema } from "@/lib/schema-org";
import { getToplistBrands, getMiniReviewItems } from "@/lib/rankings";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroToplist from "@/components/toplist/HeroToplist.astro";
import PartnerList from "@/components/toplist/PartnerList.astro";
import BestOverall from "@/components/toplist/BestOverall.astro";
import MiniReview from "@/components/toplist/MiniReview.astro";
import ContentGrid from "@/components/toplist/ContentGrid.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import ExitPopup from "@/components/toplist/ExitPopup.astro";

/* "home" là id DÀNH RIÊNG cho trang chủ, đừng đặt cho ngách nào khác. Viết
   thẳng chuỗi ở cả hai chỗ vì `getStaticPaths` được Astro hoist ra ngoài, không
   thấy hằng khai ở thân module. */

export async function getStaticPaths() {
  const entries = await getCollection("toplists");
  return entries.map((entry) => ({
    params: { toplist: entry.id === "home" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const rankingId = typeof data.ranking === "string" ? data.ranking : data.ranking.id;
const brands = await getToplistBrands(rankingId);

/* `BestOverall` lặp lại card hạng 1. File xếp hạng rỗng thì trước đây `brands[0]` là
   `undefined` và section đó render ra rác mà build vẫn xanh — cho nó thành lỗi build,
   đúng như mọi chỗ khác trong repo. */
const [topBrand] = brands;
if (!topBrand) throw new Error(`Bang xep hang "${rankingId}" rong: can it nhat mot brand`);

/* Banner khuyến mãi: logo và link affiliate lấy từ `brands`, không khai lại —
   đổi link đối tác vẫn chỉ là sửa một dòng trong content/brands/. */
let promo;
if (data.promo) {
  const promoBrandId =
    typeof data.promo.brand === "string" ? data.promo.brand : data.promo.brand.id;
  const promoBrand = (await getEntry("brands", promoBrandId))!.data;
  promo = {
    logo: promoBrand.logo,
    logoAlt: data.promo.logoAlt,
    title: data.promo.title,
    buttonText: data.promo.buttonText,
    href: promoBrand.affiliateUrl,
    afterRank: data.promo.afterRank,
  };
}

/* Khối "Review Highlights": ba brand đầu bảng có bài review.
   Con số 3 là của bản gốc (`maxMiniReviewsPerPage`) — nó là quyết định TRÌNH BÀY
   (bao nhiêu khối cho vừa trang) chứ không phải nội dung, nên để ở đây chứ không
   nhét thành một trường trong file nội dung. */
const miniReviews = await getMiniReviewItems(rankingId, 3);

/* organization + website schema chỉ phát ở trang chủ: hai kiểu đó mô tả CẢ SITE,
   phát lại ở từng ngách là khai trùng. */
const schema = entry.id === "home" ? [organizationSchema(), websiteSchema()] : [];
---

<BaseLayout title={data.title} description={data.description} schema={schema}>
  <Header />
  <main id="main-content">
    <HeroToplist
      title={data.heroTitle}
      subtitle={data.heroSubtitle}
      subtitleCompact={data.heroSubtitleCompact}
      alt={data.heroAlt}
    />
    <PartnerList brands={brands} promo={promo} />
    <BestOverall title={data.bestOverallTitle} brand={topBrand} />
    <MiniReview title={data.miniReviewTitle} items={miniReviews} />
    <ContentGrid toplist={entry} />
  </main>
  <Footer />
  <ToTop />
  <ExitPopup />
</BaseLayout>
