---
import { organizationSchema, websiteSchema } from "@/lib/schema-org";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroHome from "@/components/sections/HeroHome.astro";
import Toplist from "@/components/sections/Toplist.astro";
import BestOverall from "@/components/sections/BestOverall.astro";
import MiniReview from "@/components/sections/MiniReview.astro";
import ContentGrid from "@/components/sections/ContentGrid.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import ExitPopup from "@/components/layout/ExitPopup.astro";
---

<BaseLayout schema={[organizationSchema(), websiteSchema()]}>
  <Header />
  <main>
    <HeroHome />
    <Toplist />
    <BestOverall />
    <MiniReview />
    <ContentGrid />
  </main>
  <Footer />
  <ToTop />
  <ExitPopup />
</BaseLayout>
