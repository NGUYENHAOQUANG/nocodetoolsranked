---
/* Trang lấy dữ liệu, component nhận props.
   Trước đây năm component tự gọi `getEntry(..., "homepage")` nên mỗi cái chỉ
   chạy được cho đúng một trang. */
import { getEntry } from "astro:content";
import { organizationSchema, websiteSchema } from "@/lib/schema-org";
import { getToplistBrands } from "@/lib/rankings";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroHome from "@/components/sections/HeroHome.astro";
import Toplist from "@/components/sections/Toplist.astro";
import BestOverall from "@/components/sections/BestOverall.astro";
import MiniReview from "@/components/sections/MiniReview.astro";
import ContentGrid from "@/components/sections/ContentGrid.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import ExitPopup from "@/components/layout/ExitPopup.astro";
import thePetsTable from "@/assets/brands/the-pets-table.svg";

const brands = await getToplistBrands("homepage");

/* Truyền cả entry chứ không render sẵn rồi truyền `Content` xuống — xem ghi chú
   trong FeaturedArticle.astro: làm vậy Astro mất dấu style của MDX. */
const article = (await getEntry("featuredArticles", "homepage"))!;

const faq = (await getEntry("faq", "homepage"))!.data.items;
const miniReview = (await getEntry("miniReviews", "homepage"))!.data;

/** Banner khuyến mãi chèn xen giữa danh sách, ngay sau card hạng này */
const promo = {
  logo: thePetsTable,
  logoAlt: "The Pet's Table - ",
  title: " 100% Money-Back Guarantee",
  buttonText: "Get Started",
  href: "#",
  afterRank: 2,
};
---

<BaseLayout schema={[organizationSchema(), websiteSchema()]}>
  <Header />
  <main>
    <HeroHome />
    <Toplist brands={brands} promo={promo} />
    <BestOverall brand={brands[0]} />
    <MiniReview
      brand={brands[0]}
      categories={miniReview.categories}
      pros={miniReview.pros}
      cons={miniReview.cons}
      summary={miniReview.summary}
    />
    <ContentGrid article={article} faq={faq} />
  </main>
  <Footer />
  <ToTop />
  <ExitPopup />
</BaseLayout>
