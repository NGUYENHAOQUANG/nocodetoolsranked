---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import KnowledgeGrid from "../../components/KnowledgeGrid.astro";
import Footer from "../../components/Footer.astro";
import ToTop from "../../components/ToTop.astro";
---

<BaseLayout title="Top 10 Dog Food Subscriptions of 2026 - Learn more!">
  <Header />
  <Hero
    inner
    title="Knowledge"
    mobileTitle="Knowledge Center"
    alt="Knowledge | Fresh Dog Food Delivery"
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: "Knowledge" }]} />
  <main>
    <KnowledgeGrid />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
