---
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import KnowledgeGrid from "@/components/knowledge/KnowledgeGrid.astro";

const TITLE = "Knowledge";
---

{/* Banner ghi "Knowledge" ở cả hai bề rộng. "Knowledge Center" chỉ dùng cho tiêu đề tab. */}
<InnerPageLayout
  title="Knowledge Center - Get Answers to all Website Builder Questions"
  description="Learn everything you want to know about the best website builder services available. Read all about the pros of using the different services."
  heroTitle={TITLE}
  crumbs={[{ text: "Home" }, { text: TITLE }]}
>
  <main id="main-content">
    <KnowledgeGrid />
  </main>
</InnerPageLayout>
