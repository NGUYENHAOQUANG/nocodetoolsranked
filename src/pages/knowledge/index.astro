---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import HeroInner from "@/components/sections/HeroInner.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import KnowledgeGrid from "@/components/sections/KnowledgeGrid.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
---

<BaseLayout title="Top 10 Dog Food Subscriptions of 2026 - Learn more!">
  <Header />
  <HeroInner
    title="Knowledge"
    mobileTitle="Knowledge Center"
    alt="Knowledge | Fresh Dog Food Delivery"
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: "Knowledge" }]} />
  <main>
    <KnowledgeGrid />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
