---
/* Mỗi file MDX trong src/content/posts → một trang /knowledge/<slug>/
   Thay cho 6 thư mục pages/<slug>/index.astro viết tay của bản cũ: thêm bài
   giờ là thêm ĐÚNG MỘT file .mdx, không đụng code. */
import { getCollection } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("posts");
  /* Truyền thẳng entry chứ không truyền `entry.id` rồi để layout đi tra lại:
     chuỗi làm khoá tra bảng là đúng thứ reference() sinh ra để diệt. */
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<PostLayout entry={entry} />
