---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import InnerNavigator from "@/components/article/InnerNavigator.astro";
import ReviewIntro from "@/components/article/ReviewIntro.astro";
import ProsCons from "@/components/brand/ProsCons.astro";
import ArticleLink from "@/components/article/ArticleLink.astro";
import ReviewSidebar from "@/components/sidebar/ReviewSidebar.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
import { getPartnerLogos } from "@/lib/rankings";
import { REVIEWS_INDEX } from "@/lib/links";

/** Mỗi file MDX trong src/content/reviews → một trang /reviews/<brand>/
    Tham số lấy từ `entry.id` (tên file), KHÔNG phải trường `slug` khai tay:
    hai nguồn sự thật cho URL là nguyên nhân của lỗi thiếu "s" trong
    /sunday-for-dogs-review/ (file vốn là sundays-for-dogs.mdx). */
export async function getStaticPaths() {
  const entries = await getCollection("reviews");
  return entries.map((entry) => ({
    params: { brand: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, heroTitle, promo, href, author, pros, cons, partner, articleLinkName } = entry.data;

/* Logo đối tác cho thanh trên (ReviewIntro). Carousel sidebar tự dựng từ
   carouselPartners, chỉ cần biết đối tác hiện tại (`partner`). */
const { logo, logoAlt } = (await getPartnerLogos())[partner];

/* Bản gốc: "Home" KHÔNG có href (không phải link), mốc giữa mới là link, và
   mốc cuối lại ghi "Reviews" chứ không phải tên bài. Giữ nguyên cả ba. */
const crumbs = [
  { text: "Home" },
  { text: "Reviews", href: REVIEWS_INDEX },
  { text: "Reviews" },
];
---

<BaseLayout title={title}>
  <Header />
  {/* Bản gốc: desktop ghi "Reviews", mobile lại ghi tên bài */}
  <Hero
    inner
    title="Reviews"
    alt="Reviews | Fresh Dog Food Delivery"
    mobileTitle={heroTitle}
    mobileAlt={`${heroTitle} | Fresh Dog Food Delivery`}
  />
  <Breadcrumbs items={crumbs} />

  <div class="review-layout">
    {/* TOC lấy thẳng từ heading của bài — không khai tay, khỏi lệch khi sửa bài */}
    <InnerNavigator headings={headings} />
    <main class="review-layout__main">
      <ReviewIntro logo={logo} logoAlt={logoAlt} promo={promo} href={href} author={author} />
      {/* Bản gốc gom Pros/Cons + toàn bộ bài + link cuối vào CHUNG một section */}
      <section class="review">
        <div class="review__body">
          <ProsCons pros={pros} cons={cons} />
          <Content />
          {/* Tên đối tác ở link cuối bài (không có dấu nháy) */}
          <ArticleLink name={articleLinkName} href={href} />
        </div>
      </section>
    </main>
    <ReviewSidebar partner={partner} />
  </div>

  <Footer />
  <ToTop />
</BaseLayout>

<style>
  /* Dưới 1025px: 1 cột (nội dung rồi tới sidebar), TOC ẩn hẳn */
  .review-layout {
    width: 95%;
    margin: 10px;
    display: grid;
    grid-template-areas:
      "main"
      "sidebar";
    grid-template-columns: 100%;
  }

  .review-layout__main {
    width: 100%;
    margin: 0 auto 10px;
    border: 1px solid #ecebeb;
  }

  /* Section bọc Pros/Cons + bài + link cuối. Rule chung cho mọi <section> của
     bản gốc: padding 0 10px, margin 0 (đổi thành 2px auto 30px từ 1025px). */
  .review {
    position: relative;
    margin: 0;
    padding-inline: 10px;
  }

  @media (min-width: 1025px) and (min-height: 420px) {
    .review-layout {
      max-width: 1060px;
      margin: 25px auto;
      grid-template-areas: "nav main sidebar";
      grid-template-columns: 1fr 2.8fr 1fr;
      gap: 10px;
    }
    .review-layout__main {
      margin-right: 0;
      padding-right: 20px;
      border: none;
    }
    .review {
      margin: 2px auto 30px;
    }
  }
</style>
