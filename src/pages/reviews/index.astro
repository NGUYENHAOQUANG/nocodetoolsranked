---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ReviewsList from "../../components/ReviewsList.astro";
import Footer from "../../components/Footer.astro";
import ToTop from "../../components/ToTop.astro";

const TITLE = "Top Dog Food Delivery Reviews";
---

<BaseLayout title="Dog Food Subscription Reviews">
  <Header />
  <Hero inner title={TITLE} alt={`${TITLE} | Fresh Dog Food Delivery`} />
  <Breadcrumbs items={["Home", TITLE]} />
  <main>
    <ReviewsList />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
