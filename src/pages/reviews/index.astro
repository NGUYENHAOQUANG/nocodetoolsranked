---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ReviewsList from "../../components/ReviewsList.astro";
import Footer from "../../components/Footer.astro";
import ToTop from "../../components/ToTop.astro";

const TITLE = "Top Dog Food Delivery Reviews";
---

<BaseLayout title="Dog Food Subscription Reviews">
  <Header />
  {/* Bản gốc mobile xuống dòng cứng sau "Delivery" (<br>), desktop để 1 dòng */}
  <Hero
    inner
    title={TITLE}
    mobileTitle="Top Dog Food Delivery <br> Reviews"
    alt={`${TITLE} | Fresh Dog Food Delivery`}
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: TITLE }]} />
  <main>
    <ReviewsList />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
