---
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import ReviewsList from "@/components/review/ReviewsList.astro";

const TITLE = "Reviews";
---

{/* Banner chỉ một từ "Reviews" ở cả hai bề rộng nên không khai heroMobileTitle */}
<InnerPageLayout
  title="Reviews - Read in-depth About the Best Website Builders"
  description="Checkout the reviews of the best website builders. Read their unbiased expert reviews, services and offers to get the best deals."
  heroTitle={TITLE}
  crumbs={[{ text: "Home" }, { text: TITLE }]}
>
  <main id="main-content">
    <ReviewsList />
  </main>
</InnerPageLayout>
