---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ReviewsList from "@/components/sections/ReviewsList.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";

const TITLE = "Top Dog Food Delivery Reviews";
---

<BaseLayout title="Dog Food Subscription Reviews">
  <Header />
  {/* Bản gốc mobile xuống dòng cứng sau "Delivery" (<br>), desktop để 1 dòng */}
  <Hero
    inner
    title={TITLE}
    mobileTitle="Top Dog Food Delivery <br> Reviews"
    alt={`${TITLE} | Fresh Dog Food Delivery`}
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: TITLE }]} />
  <main>
    <ReviewsList />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
