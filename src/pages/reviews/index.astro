---
import InnerPageLayout from "@/layouts/InnerPageLayout.astro";
import ReviewsList from "@/components/reviews/ReviewsList.astro";

const TITLE = "Top Dog Food Delivery Reviews";
---

{/* Bản gốc mobile xuống dòng cứng sau "Delivery" (<br>), desktop để 1 dòng */}
<InnerPageLayout
  title="Dog Food Subscription Reviews"
  heroTitle={TITLE}
  heroMobileTitle="Top Dog Food Delivery <br> Reviews"
  crumbs={[{ text: "Home" }, { text: TITLE }]}
>
  <main id="main-content">
    <ReviewsList />
  </main>
</InnerPageLayout>
