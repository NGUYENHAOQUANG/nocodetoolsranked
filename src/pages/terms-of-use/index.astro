<style>
  /* Cùng khung prose như bản gốc (paragraph_paragraph): rộng 95%, tối đa 1060,
     căn giữa. Bản gốc dùng overflow:auto → BFC GÓI margin con lại (margin <p>
     đầu/cuối không collapse ra ngoài); dùng display:flow-root để tái hiện.
     <1025 breadcrumb ẩn → sát hero (margin trên 0), cách footer = 14 (margin <p>
     cuối, được BFC gói) + 0. ≥1025 thêm 2px trên (cách breadcrumb) + 30px dưới
     → tổng cách footer = 16 (gói) + 30 = 46 như bản gốc. */
  .terms {
    display: flow-root;
    width: 95%;
    max-width: 1060px;
    margin: 0 auto;
    color: #2d2d2d;
    font-size: 1rem;
    line-height: 1.7rem;
  }
  .terms p {
    margin: 1em 0;
  }
  @media (min-width: 1025px) {
    .terms {
      margin: 2px auto 30px;
    }
  }
</style>
