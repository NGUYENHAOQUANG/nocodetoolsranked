---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactCards from "../../components/ContactCards.astro";
import Footer from "../../components/Footer.astro";
import ToTop from "../../components/ToTop.astro";
---

<BaseLayout title="Top 10 Dog Food Subscriptions - Contact Us">
  <Header />
  <Hero
    inner
    title="Contact Us"
    mobileTitle="Contact Us"
    alt="Contact Us | Fresh Dog Food Delivery"
  />
  <Breadcrumbs items={[{ text: "Home" }, { text: "Contact Us" }]} />
  <main>
    <ContactCards />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>
