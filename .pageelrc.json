{
  "version": 2,
  "collections": [
    {
      "id": "posts",
      "name": "Blog Posts",
      "postsPath": "src/content/posts",
      "imagesPath": "src/assets",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "heroMobileTitle",
            "type": "string"
          },
          {
            "name": "excerpt",
            "type": "string"
          },
          {
            "name": "excerptLong",
            "type": "string"
          },
          {
            "name": "readTime",
            "type": "string"
          },
          {
            "name": "author",
            "type": "string"
          },
          {
            "name": "date",
            "type": "date"
          }
        ]
      }
    },
    {
      "id": "reviews",
      "name": "Brand Reviews",
      "postsPath": "src/content/reviews",
      "imagesPath": "src/assets",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "heroTitle",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "promo",
            "type": "string"
          },
          {
            "name": "brand",
            "type": "string"
          },
          {
            "name": "author",
            "type": "string"
          },
          {
            "name": "summary",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "pages",
      "name": "Site Pages",
      "postsPath": "src/content/pages",
      "imagesPath": "src/assets",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "heroTitle",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "headingStyle",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "toplists",
      "name": "Toplists",
      "postsPath": "src/content/toplists",
      "imagesPath": "src/assets",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "heroTitle",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          }
        ]
      }
    }
  ],
  "activeCollectionId": "posts",
  "settings": {
    "projectType": "astro",
    "postFileTypes": ".md,.mdx",
    "imageFileTypes": ".png,.jpg,.jpeg,.gif,.svg,.webp"
  },
  "plugins": {
    "editor": "@pageel/plugin-mdx"
  }
}
